@page "/contacts/new"
@page "/contacts/{Id}"
@inject IRepository<Contact> Contacts
@inject IRepository<Company> Companies
@inject DealService Deals
@inject PipelineService Pipelines
@inject ActivityService Activities
@inject AutomationService Automations
@inject UserService Users
@inject CurrentUser Me
@inject DrawerService Drawer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DialogService Dialogs

<PageTitle>Dana · @(IsNew ? "Nuevo contacto" : _model.FullName)</PageTitle>

@if (_loading)
{
    <p class="muted">Cargando…</p>
    return;
}

<div class="page-head">
    <div class="d-flex align-items-center gap-3">
        <span class="avatar avatar-letter" style="width:44px;height:44px;font-size:1rem;background:@Avatar.ColorFor(_model.FullName)">@Avatar.Initials(IsNew ? "?" : _model.FullName)</span>
        <div>
            <h3>@(IsNew ? "Nuevo contacto" : _model.FullName)</h3>
            <div class="sub">@_model.Position @(_company is null ? "" : $"· {_company.Title}")</div>
        </div>
    </div>
    <div class="actions">
        @if (!Embedded) { <a class="btn-secondary" href="contacts">← Tablero</a> }
        @if (!IsNew) { <CopyLink Path="@($"contacts/{_model.Id}")" /> }
        @if (!ReadOnly && !IsNew)
        {
            <a class="btn-secondary" href="deals/new?contactId=@_model.Id&companyId=@_model.CompanyId">+ Negociación</a>
            <button class="btn-secondary" @onclick="() => _emailOpen = true" disabled="@string.IsNullOrWhiteSpace(_model.Email)">✉ Enviar correo</button>
            <button class="btn-secondary" @onclick="ArchiveAsync">@(_model.IsArchived ? "↩ Restaurar" : "🗂 Archivar")</button>
            <button class="btn-danger" @onclick="DeleteAsync">Eliminar</button>
        }
    </div>
</div>

@if (_model.IsArchived) { <div class="alert alert-secondary">Este elemento está <strong>archivado</strong>. No aparece en el tablero salvo con el filtro "Archivados".</div> }

<div class="item-view @(IsNew ? "single" : "")">
    <div>
        <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="contactForm">
            <DataAnnotationsValidator />
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Información</span>
                    @if (!_editing && !ReadOnly) { <button type="button" class="btn-secondary btn-sm" @onclick="() => _editing = true">✎ Editar</button> }
                </div>
                <div class="card-body">
                    @if (_editing)
                    {
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Nombre *</label>
                            <InputText class="form-control" @bind-Value="_model.Name" />
                            <ValidationMessage For="() => _model.Name" />
                        </div>
                        <div class="col-md-4"><label class="form-label">Apellido</label><InputText class="form-control" @bind-Value="_model.LastName" /></div>
                        <div class="col-md-4"><label class="form-label">Cargo</label><InputText class="form-control" @bind-Value="_model.Position" /></div>
                        <div class="col-md-6">
                            <label class="form-label">Compañía</label>
                            <SearchSelect TItem="Company" Items="_companies"
                                          IdFor="c => c.Id!" LabelFor="c => c.Title" SubFor="c => c.Industry"
                                          Value="_model.CompanyId" ValueChanged="OnCompanyChanged"
                                          Placeholder="— Sin compañía —" EmptyText="Sin compañías" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo</label>
                            <SearchSelect TItem="string" Items="Catalogs.ContactTypes"
                                          IdFor="t => t" LabelFor="t => t"
                                          Value="_model.Type" ValueChanged="v => _model.Type = v" Placeholder="—" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fuente</label>
                            <SearchSelect TItem="string" Items="Catalogs.Sources"
                                          IdFor="s => s" LabelFor="s => s"
                                          Value="_model.Source" ValueChanged="v => _model.Source = v" Placeholder="—" />
                        </div>
                        <div class="col-md-4"><label class="form-label">Teléfono</label><InputText class="form-control" @bind-Value="_model.Phone" /></div>
                        <div class="col-md-4">
                            <label class="form-label">Correo</label>
                            <InputText class="form-control" @bind-Value="_model.Email" />
                            <ValidationMessage For="() => _model.Email" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Responsable</label>
                            <SearchSelect TItem="string" Items="_people"
                                          IdFor="p => p" LabelFor="p => p"
                                          Value="_model.AssignedTo" ValueChanged="v => _model.AssignedTo = v" Placeholder="Sin asignar" />
                        </div>
                        <div class="col-12"><label class="form-label">Dirección</label><InputText class="form-control" @bind-Value="_model.Address" /></div>
                        <div class="col-12"><label class="form-label">Comentarios</label><InputTextArea class="form-control" rows="3" @bind-Value="_model.Comments" /></div>
                    </div>
                    }
                    else
                    {
                        <div class="info-grid">
                            <FieldView Label="Nombre" Value="@_model.Name" />
                            <FieldView Label="Apellido" Value="@_model.LastName" />
                            <FieldView Label="Cargo" Value="@_model.Position" />
                            <FieldView Label="Compañía" Value="@_company?.Title" />
                            <FieldView Label="Tipo" Value="@_model.Type" />
                            <FieldView Label="Fuente" Value="@_model.Source" />
                            <FieldView Label="Teléfono" Value="@_model.Phone" />
                            <FieldView Label="Correo" Value="@_model.Email" />
                            <FieldView Label="Responsable" Value="@_model.AssignedTo" />
                            <FieldView Label="Dirección" Value="@_model.Address" Wide="true" />
                            <FieldView Label="Comentarios" Value="@_model.Comments" Wide="true" />
                        </div>
                    }
                </div>
                @if (_editing)
                {
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="muted small">@(_saved ? "✓ Guardado" : "")</span>
                        <span class="d-flex gap-2">
                            <button type="button" class="btn-secondary" @onclick="CancelEdit">Cancelar</button>
                            <button type="submit" class="btn-primary" disabled="@_busy">Guardar</button>
                        </span>
                    </div>
                }
            </div>
        </EditForm>

        @if (!IsNew)
        {
            <div class="card mt-3">
                <div class="card-header">Negociaciones <span class="muted">(@_deals.Count)</span></div>
                <div class="card-body">
                    @if (_deals.Count == 0) { <div class="muted">Sin negociaciones.</div> }
                    <ul class="list-rows">
                        @foreach (var d in _deals)
                        {
                            var stage = _pipelines.GetValueOrDefault(d.PipelineId)?.GetStage(d.StageId);
                            <li>
                                <span><a href="deals/@d.Id">@d.Title</a> @if (stage is not null) { <Badge Text="@stage.Name" Color="@stage.Color" /> }</span>
                                <Money Amount="d.Amount" Currency="@d.Currency" />
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    @if (!IsNew)
    {
        <div>
        <TaskList EntityType="contact" EntityId="@_model.Id" EntityTitle="@(_model.FullName)" />
        <div class="card mt-3">
            <div class="card-header">Actualizaciones</div>
            <div class="card-body">
                <Updates EntityType="contact" EntityId="@_model.Id" EntityTitle="@(_model.FullName)" />
            </div>
        </div>
        </div>
    }
</div>

<EmailComposer @bind-Open="_emailOpen" To="@(_model.Email)" Context="@(new EmailContext(_model.Name, _model.LastName, _company?.Title, _model.Email, _model.FullName, string.Empty))" EntityType="contact" EntityId="@(_model.Id ?? string.Empty)" EntityTitle="@(_model.FullName)" />

@code {
    private bool _emailOpen;
    [Parameter] public string? Id { get; set; }
    [CascadingParameter(Name = "ReadOnly")] private bool ReadOnly { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [SupplyParameterFromQuery(Name = "companyId")] public string? QueryCompanyId { get; set; }
    private bool IsNew => string.IsNullOrEmpty(Id);

    private Contact _model = new();
    private Company? _company;
    private List<Company> _companies = new();
    private List<Deal> _deals = new();
    private List<string> _people = new();
    private Dictionary<string, Pipeline> _pipelines = new();
    private bool _loading = true;
    private bool _busy, _saved;
    private bool _editing;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _companies = (await Companies.GetAllAsync()).OrderBy(c => c.Title).ToList();
        _people = (await Users.GetAllAsync()).Where(u => u.IsActive).Select(u => u.Name).OrderBy(n => n).ToList();
        if (IsNew)
        {
            _model = new Contact { CompanyId = string.IsNullOrEmpty(QueryCompanyId) ? null : QueryCompanyId, AssignedTo = await Me.NameAsync() };
        }
        else
        {
            var found = await Contacts.GetByIdAsync(Id);
            if (found is null) { Nav.NavigateTo("contacts"); return; }
            _model = found;
            _deals = await Deals.GetByContactAsync(_model.Id!);
            _pipelines = (await Pipelines.GetAllAsync()).ToDictionary(p => p.Id!);
        }
        _company = _companies.FirstOrDefault(c => c.Id == _model.CompanyId);
        _editing = IsNew;
        _loading = false;
    }

    private async Task CancelEdit()
    {
        if (IsNew) { if (Embedded) await Drawer.CloseAsync(); else Nav.NavigateTo("contacts"); return; }
        var found = await Contacts.GetByIdAsync(Id);
        if (found is not null) { _model = found; _company = _companies.FirstOrDefault(c => c.Id == _model.CompanyId); }
        _editing = false;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            if (string.IsNullOrEmpty(_model.CompanyId)) _model.CompanyId = null;
            var wasNew = IsNew;
            if (wasNew)
            {
                _model.CreatedBy = await Me.NameAsync();
                await Contacts.InsertAsync(_model);
                await Activities.LogAsync("contact", _model.Id!, _model.FullName, ActivityKinds.Created, "Creó el contacto", await Me.NameAsync());
                await Automations.TriggerAsync(new AutomationEvent("contacts", TriggerTypes.Created, _model, await Me.NameAsync()));
            }
            else { _model.UpdatedBy = await Me.NameAsync(); await Contacts.UpdateAsync(_model); }
            _saved = true;
            _editing = false;
            _company = _companies.FirstOrDefault(c => c.Id == _model.CompanyId);
            if (Embedded)
            {
                await Drawer.NotifyChangedAsync();
                if (wasNew) Drawer.Open<ContactEdit>(_model.Id, "Contacto");
            }
            else if (wasNew) Nav.NavigateTo($"contacts/{_model.Id}");
        }
        finally { _busy = false; }
    }

    private void OnCompanyChanged(string? id)
    {
        _model.CompanyId = id;
        _company = _companies.FirstOrDefault(c => c.Id == id);
    }

    private async Task DeleteAsync()
    {
        if (!await Dialogs.ConfirmAsync($"¿Eliminar el contacto \"{_model.FullName}\"?")) return;
        await Contacts.DeleteAsync(_model.Id!, await Me.NameAsync());
        if (Embedded) { await Drawer.NotifyChangedAsync(); await Drawer.CloseAsync(); }
        else Nav.NavigateTo("contacts");
    }

    private async Task ArchiveAsync()
    {
        _model.IsArchived = !_model.IsArchived;
        await Contacts.UpdateAsync(_model);
        if (Embedded) { await Drawer.NotifyChangedAsync(); await Drawer.CloseAsync(); }
    }
}
