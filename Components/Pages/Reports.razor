@page "/informes"
@inject ReportService ReportSvc
@inject UserService Users
@inject IJSRuntime JS
@inject DialogService Dialogs

<PageTitle>Dana · Informes</PageTitle>

<PageHeader Title="Informes" Subtitle="Panel configurable: agregue, mueva y redimensione widgets. Los datos excluyen elementos archivados.">
    <Actions>
        <select class="form-select" style="width:auto" value="@_person" @onchange="async e => { _person = e.Value?.ToString() ?? string.Empty; await RecomputeAsync(); }">
            <option value="">👤 Todas las personas</option>
            @foreach (var p in _people) { <option value="@p">@p</option> }
        </select>
        <button class="tool @(_editing ? "on" : "")" @onclick="() => _editing = !_editing">✎ @(_editing ? "Terminar edición" : "Editar panel")</button>
        <button class="btn-primary" @onclick="NewWidget">+ Widget</button>
    </Actions>
</PageHeader>

@if (_dash is null || _snap is null)
{
    <p class="muted">Cargando…</p>
}
else
{
    <div class="widgets">
        @foreach (var w in _dash.Widgets)
        {
            var data = _data.GetValueOrDefault(w.Id);
            <div class="widget w-@w.Width report-widget">
                <div class="widget-title">
                    <span>@w.Title <small class="muted fw-normal">@PeriodLabel(w)</small></span>
                    @if (_editing)
                    {
                        <span class="d-flex gap-1">
                            <button class="icon-btn tiny" title="Mover a la izquierda" @onclick="() => MoveAsync(w, -1)">←</button>
                            <button class="icon-btn tiny" title="Mover a la derecha" @onclick="() => MoveAsync(w, +1)">→</button>
                            <button class="icon-btn tiny" title="Más angosto" @onclick="() => ResizeAsync(w, -1)">−</button>
                            <button class="icon-btn tiny" title="Más ancho" @onclick="() => ResizeAsync(w, +1)">+</button>
                            <button class="icon-btn tiny" title="Configurar" @onclick="() => { _draft = Clone(w); _sheet = true; }">⚙</button>
                            <button class="icon-btn tiny" title="Quitar" @onclick="() => RemoveAsync(w)">✕</button>
                        </span>
                    }
                </div>
                @if (data is null) { <div class="muted">…</div> }
                else if (w.Type == WidgetTypes.Number)
                {
                    <div class="hero-number">@(w.Metric == "count" ? data.Total.ToString("N0") : "$" + data.Total.ToString("N0"))</div>
                    <div class="muted small">@data.Subtitle</div>
                }
                else if (w.Type == WidgetTypes.Conversion)
                {
                    <div class="hero-number">@data.Total.ToString("N0") %</div>
                    <div class="muted small mb-2">@data.Subtitle</div>
                    <Chart Data="data" Type="@WidgetTypes.Bar" />
                }
                else if (w.Type is WidgetTypes.Table or WidgetTypes.Leaderboard)
                {
                    @if (w.Type == WidgetTypes.Leaderboard) { <Chart Data="data" Type="@WidgetTypes.Bar" /> }
                    <table class="report-table">
                        <thead><tr>@foreach (var c in data.Columns ?? new()) { <th>@c</th> }</tr></thead>
                        <tbody>@foreach (var r in data.Rows ?? new()) { <tr>@foreach (var c in r) { <td>@c</td> }</tr> }</tbody>
                    </table>
                }
                else if (w.Type == WidgetTypes.Forecast)
                {
                    <div class="hero-number small-hero">$@data.Total.ToString("N0") <small class="muted">ponderado abierto</small></div>
                    <Chart Data="data" Type="@WidgetTypes.Bar" />
                    @if (data.Subtitle is not null) { <div class="muted small">@data.Subtitle</div> }
                }
                else
                {
                    @if (data.Subtitle is not null) { <div class="muted small mb-1">@data.Subtitle</div> }
                    <Chart Data="data" Type="@(w.Type == WidgetTypes.StageTime ? WidgetTypes.Bar : w.Type)" />
                }
            </div>
        }
    </div>
    @if (_editing)
    {
        <div class="mt-3"><button class="btn-secondary btn-sm" @onclick="ResetAsync">Restablecer panel predeterminado</button></div>
    }
}

@if (_sheet && _draft is not null)
{
    <div class="sheet-backdrop" @onclick="() => _sheet = false"></div>
    <div class="sheet">
        <div class="sheet-head"><strong>@(_dash!.Widgets.Any(x => x.Id == _draft.Id) ? "Configurar widget" : "Nuevo widget")</strong><button class="icon-btn" @onclick="() => _sheet = false">✕</button></div>
        <div class="sheet-body">
            <label class="form-label">Título</label>
            <input class="form-control mb-2" @bind="_draft.Title" />
            <label class="form-label">Tipo</label>
            <div class="type-grid mb-2">
                @foreach (var (id, label, hint) in WidgetTypes.All)
                {
                    <button class="type-opt @(_draft.Type == id ? "selected" : "")" title="@hint" @onclick="() => PickType(id)">@label</button>
                }
            </div>
            @if (_draft.Type is not (WidgetTypes.Forecast or WidgetTypes.Leaderboard or WidgetTypes.StageTime or WidgetTypes.Conversion))
            {
                <div class="row g-2">
                    <div class="col-6"><label class="form-label">Tablero</label>
                        <select class="form-select" @bind="_draft.Board"><option value="deals">Negociaciones</option><option value="leads">Prospectos</option><option value="contacts">Contactos</option><option value="companies">Compañías</option></select></div>
                    <div class="col-6"><label class="form-label">Medida</label>
                        <select class="form-select" @bind="_draft.Metric"><option value="count">Cantidad</option>@if (_draft.Board is "deals" or "leads") { <option value="amount">Importe</option> }@if (_draft.Board == "deals") { <option value="weighted">Importe ponderado</option> }</select></div>
                    @if (_draft.Type is not (WidgetTypes.Number or WidgetTypes.Funnel))
                    {
                        <div class="col-6"><label class="form-label">Agrupar por</label>
                            <select class="form-select" @bind="_draft.GroupBy">@foreach (var g in ReportGroups.All.Where(g => g.Boards.Contains(_draft.Board))) { <option value="@g.Id">@g.Label</option> }</select></div>
                    }
                    @if (_draft.Board is "deals" or "leads")
                    {
                        <div class="col-6"><label class="form-label">Alcance</label>
                            <select class="form-select" @bind="_draft.Scope"><option value="all">Todas</option><option value="open">Abiertas</option>@if (_draft.Board == "deals") { <option value="won">Ganadas</option><option value="lost">Perdidas</option> }</select></div>
                    }
                </div>
            }
            <div class="row g-2 mt-1">
                <div class="col-6"><label class="form-label">Periodo</label>
                    <select class="form-select" @bind="_draft.Period"><option value="all">Todo</option><option value="30d">Últimos 30 días</option><option value="90d">Últimos 90 días</option><option value="year">Este año</option></select></div>
                <div class="col-6"><label class="form-label">Ancho</label>
                    <select class="form-select" @bind="_draft.Width"><option value="3">1/4</option><option value="4">1/3</option><option value="6">1/2</option><option value="8">2/3</option><option value="12">Completo</option></select></div>
            </div>
        </div>
        <div class="sheet-foot">
            <button class="btn-secondary" @onclick="() => _sheet = false">Cancelar</button>
            <button class="btn-primary" @onclick="SaveWidgetAsync">Guardar</button>
        </div>
    </div>
}

@code {
    private ReportDashboard? _dash;
    private ReportService.Snapshot? _snap;
    private readonly Dictionary<string, ChartData> _data = new();
    private List<string> _people = new();
    private string _person = "";
    private bool _editing, _sheet;
    private ReportWidget? _draft;

    protected override async Task OnInitializedAsync()
    {
        _people = (await Users.GetAllAsync()).Where(u => u.IsActive).Select(u => u.Name).OrderBy(n => n).ToList();
        _dash = await ReportSvc.GetDashboardAsync();
        _snap = await ReportSvc.LoadAsync();
        await RecomputeAsync();
    }

    private Task RecomputeAsync()
    {
        _data.Clear();
        foreach (var w in _dash!.Widgets)
        {
            var eff = Clone(w); eff.Person = string.IsNullOrEmpty(_person) ? w.Person : _person;
            try { _data[w.Id] = ReportSvc.Compute(eff, _snap!); } catch { _data[w.Id] = new ChartData(); }
        }
        return Task.CompletedTask;
    }

    private void NewWidget() { _draft = new ReportWidget { Title = "Nuevo widget" }; _sheet = true; }

    private void PickType(string id)
    {
        _draft!.Type = id;
        if (id is WidgetTypes.Forecast or WidgetTypes.Leaderboard or WidgetTypes.StageTime or WidgetTypes.Funnel) _draft.Board = "deals";
        if (id == WidgetTypes.Conversion) _draft.Board = "leads";
    }

    private static ReportWidget Clone(ReportWidget w) => new() { Id = w.Id, Title = w.Title, Type = w.Type, Board = w.Board, Metric = w.Metric, GroupBy = w.GroupBy, Period = w.Period, Person = w.Person, Scope = w.Scope, Width = w.Width };
    private static string PeriodLabel(ReportWidget w) => w.Period switch { "30d" => "· 30 días", "90d" => "· 90 días", "year" => "· este año", _ => "" };

    private async Task SaveWidgetAsync()
    {
        var existing = _dash!.Widgets.FindIndex(x => x.Id == _draft!.Id);
        if (!ReportGroups.All.Any(g => g.Id == _draft!.GroupBy && g.Boards.Contains(_draft.Board))) _draft!.GroupBy = ReportGroups.All.First(g => g.Boards.Contains(_draft.Board)).Id;
        if (existing >= 0) _dash.Widgets[existing] = _draft!; else _dash.Widgets.Add(_draft!);
        await ReportSvc.SaveAsync(_dash);
        _sheet = false;
        await RecomputeAsync();
    }

    private async Task RemoveAsync(ReportWidget w) { _dash!.Widgets.Remove(w); await ReportSvc.SaveAsync(_dash); }
    private async Task MoveAsync(ReportWidget w, int dir)
    {
        var i = _dash!.Widgets.IndexOf(w); var j = i + dir;
        if (j < 0 || j >= _dash.Widgets.Count) return;
        (_dash.Widgets[i], _dash.Widgets[j]) = (_dash.Widgets[j], _dash.Widgets[i]);
        await ReportSvc.SaveAsync(_dash);
    }
    private async Task ResizeAsync(ReportWidget w, int dir)
    {
        int[] sizes = [3, 4, 6, 8, 12];
        var i = Math.Clamp(Array.IndexOf(sizes, w.Width) + dir, 0, sizes.Length - 1);
        w.Width = sizes[i];
        await ReportSvc.SaveAsync(_dash!);
    }
    private async Task ResetAsync()
    {
        if (!await Dialogs.ConfirmAsync("¿Restablecer el panel predeterminado? Se perderán los widgets actuales.")) return;
        _dash = await ReportSvc.ResetAsync(_dash!);
        await RecomputeAsync();
    }
}
