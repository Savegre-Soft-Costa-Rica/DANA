@page "/configuracion/empresa"
@attribute [Authorize(Policy = "Admin")]
@inject SettingsService Settings
@inject CurrentUser Me

<PageTitle>Dana · Empresa y moneda</PageTitle>

<PageHeader Title="Empresa y moneda" Subtitle="Datos que aparecen en las cotizaciones, moneda base y tipos de cambio para informes." />

@if (_s is null) { <p class="muted">Cargando…</p> }
else
{
    <EditForm Model="_s" OnValidSubmit="SaveAsync" FormName="settings">
        <div class="widgets">
            <div class="widget w-6">
                <div class="widget-title">Datos de la empresa</div>
                <div class="row g-2">
                    <div class="col-12"><label class="form-label">Nombre</label><InputText class="form-control" @bind-Value="_s.CompanyName" /></div>
                    <div class="col-6"><label class="form-label">Identificación fiscal</label><InputText class="form-control" @bind-Value="_s.TaxId" /></div>
                    <div class="col-6"><label class="form-label">Teléfono</label><InputText class="form-control" @bind-Value="_s.Phone" /></div>
                    <div class="col-6"><label class="form-label">Correo</label><InputText class="form-control" @bind-Value="_s.Email" /></div>
                    <div class="col-6"><label class="form-label">Sitio web</label><InputText class="form-control" @bind-Value="_s.Web" /></div>
                    <div class="col-12"><label class="form-label">Dirección</label><InputText class="form-control" @bind-Value="_s.Address" /></div>
                </div>
            </div>
            <div class="widget w-6">
                <div class="widget-title">Moneda base y tipos de cambio</div>
                <label class="form-label">Moneda base (informes y totales)</label>
                <InputSelect class="form-select mb-2" @bind-Value="_s.BaseCurrency">@foreach (var c in Catalogs.Currencies) { <option value="@c">@c</option> }</InputSelect>
                <div class="small muted mb-2">Unidades de cada moneda por <strong>1 @_s.BaseCurrency</strong>. Ejemplo: si 1 USD = 520 CRC, escriba 520 en CRC.</div>
                @foreach (var c in Catalogs.Currencies)
                {
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span style="width:50px"><strong>@c</strong></span>
                        <input type="number" step="any" class="form-control form-control-sm" style="max-width:160px" value="@_s.Rates.GetValueOrDefault(c, 1m)" @onchange="e => _s.Rates[c] = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 1m" disabled="@(c == _s.BaseCurrency)" />
                        @if (c == _s.BaseCurrency) { <span class="muted small">moneda base</span> }
                    </div>
                }
            </div>
            <div class="widget w-6">
                <div class="widget-title">Cotizaciones</div>
                <div class="row g-2">
                    <div class="col-4"><label class="form-label">Prefijo</label><InputText class="form-control" @bind-Value="_s.QuotePrefix" /></div>
                    <div class="col-4"><label class="form-label">Siguiente número</label><InputNumber class="form-control" @bind-Value="_s.NextQuoteNumber" /></div>
                    <div class="col-4"><label class="form-label">Validez (días)</label><InputNumber class="form-control" @bind-Value="_s.QuoteValidDays" /></div>
                    <div class="col-4"><label class="form-label">Impuesto por defecto %</label><InputNumber class="form-control" @bind-Value="_s.DefaultTaxRate" /></div>
                    <div class="col-12"><label class="form-label">Términos y condiciones (pie de la cotización)</label><InputTextArea class="form-control" rows="3" @bind-Value="_s.QuoteTerms" /></div>
                </div>
            </div>

            <div class="widget w-12">
                <div class="widget-title">Datos fiscales · Hacienda — Factura electrónica 4.4 @if (!_s.Hacienda.IsComplete) { <span class="badge-soft danger">incompleto</span> }</div>
                <div class="small muted mb-2">Se usan como <strong>emisor</strong> en los comprobantes electrónicos. La razón social, identificación, correo, teléfono y dirección generales se toman de "Datos de la empresa"; aquí van los campos específicos de Hacienda.</div>
                <div class="row g-2">
                    <div class="col-md-3"><label class="form-label">Tipo de identificación</label>
                        <InputSelect class="form-select" @bind-Value="_s.Hacienda.TipoIdentificacion">@foreach (var t in AppSettings.TiposIdentificacion) { <option value="@t.Id">@t.Id · @t.Label</option> }</InputSelect></div>
                    <div class="col-md-3"><label class="form-label">Identificación (cédula)</label><InputText class="form-control" @bind-Value="_s.Hacienda.Identificacion" placeholder="cédula del emisor (sólo dígitos)" /></div>
                    <div class="col-md-3"><label class="form-label">Nombre comercial</label><InputText class="form-control" @bind-Value="_s.Hacienda.NombreComercial" /></div>
                    <div class="col-md-3"><label class="form-label">Correo para comprobantes</label><InputText class="form-control" @bind-Value="_s.Hacienda.CorreoFacturas" placeholder="correo del emisor" /></div>

                    <div class="col-md-2"><label class="form-label">Cód. país (tel.)</label><InputText class="form-control" @bind-Value="_s.Hacienda.CodigoPaisTel" /></div>
                    <div class="col-md-4"><label class="form-label">Teléfono</label><InputText class="form-control" @bind-Value="_s.Hacienda.Telefono" /></div>

                    <div class="col-12">
                        <label class="form-label">Actividades económicas <span class="muted">(códigos de 6 dígitos ante Hacienda; la 4.4 admite varias)</span></label>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            @for (var i = 0; i < _s.Hacienda.ActividadesEconomicas.Count; i++)
                            {
                                var idx = i;
                                <span class="d-inline-flex align-items-center gap-1">
                                    <input class="form-control form-control-sm" style="width:120px" value="@_s.Hacienda.ActividadesEconomicas[idx]" @onchange="e => SetActividad(idx, e.Value?.ToString())" placeholder="620100" />
                                    <button type="button" class="icon-btn tiny" title="Quitar" @onclick="() => _s.Hacienda.ActividadesEconomicas.RemoveAt(idx)">✕</button>
                                </span>
                            }
                            <button type="button" class="btn-secondary btn-sm" @onclick="() => _s.Hacienda.ActividadesEconomicas.Add(string.Empty)">+ Actividad</button>
                        </div>
                    </div>

                    <div class="col-12 mt-2"><strong class="small">Ubicación del emisor (códigos de Hacienda)</strong></div>
                    <div class="col-md-2"><label class="form-label">Provincia</label><InputText class="form-control" @bind-Value="_s.Hacienda.Provincia" placeholder="1" /></div>
                    <div class="col-md-2"><label class="form-label">Cantón</label><InputText class="form-control" @bind-Value="_s.Hacienda.Canton" placeholder="01" /></div>
                    <div class="col-md-2"><label class="form-label">Distrito</label><InputText class="form-control" @bind-Value="_s.Hacienda.Distrito" placeholder="01" /></div>
                    <div class="col-md-2"><label class="form-label">Barrio</label><InputText class="form-control" @bind-Value="_s.Hacienda.Barrio" placeholder="(opcional)" /></div>
                    <div class="col-md-4"><label class="form-label">Otras señas</label><InputText class="form-control" @bind-Value="_s.Hacienda.OtrasSenas" /></div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3 align-items-center">
            <span class="muted small">@(_saved ? "✓ Guardado" : "")</span>
            <button type="submit" class="btn-primary">Guardar</button>
        </div>
    </EditForm>
}

@code {
    private AppSettings? _s;
    private bool _saved;

    protected override async Task OnInitializedAsync() => _s = await Settings.GetAsync();

    private void SetActividad(int idx, string? value) => _s!.Hacienda.ActividadesEconomicas[idx] = value ?? string.Empty;

    private async Task SaveAsync()
    {
        _s!.Rates[_s.BaseCurrency] = 1m;
        _s.Hacienda.ActividadesEconomicas = _s.Hacienda.ActividadesEconomicas.Where(a => !string.IsNullOrWhiteSpace(a)).Select(a => a.Trim()).ToList();
        _s.UpdatedBy = await Me.NameAsync();
        await Settings.SaveAsync(_s);
        _saved = true;
    }
}
