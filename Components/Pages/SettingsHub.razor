@page "/configuracion"
@using Dana.Data
@using Dana.Models
@using Dana.Services
@using Microsoft.Extensions.Hosting
@using Dana.Services.Ai
@using Dana.Services.Invoicing
@using Dana.Services.Messaging
@using Dana.Services.Telegram
@inject SettingsService Settings
@inject AgentService Agents
@inject TelegramService TelegramBot
@inject TwilioOptions Twilio
@inject InvoiceService Invoices
@inject UserService Users
@inject EmailService Email
@inject AuthOptions Auth
@inject MongoContext Mongo
@inject IHostEnvironment Env
@inject CurrentUser Me
@inject IRepository<Lead> Leads
@inject IRepository<Deal> Deals
@inject IRepository<Contact> Contacts
@inject IRepository<Company> Companies
@inject IRepository<Pipeline> Pipelines
@inject IRepository<Automation> Automations
@inject IRepository<ApiChannel> Channels
@inject IRepository<LeadForm> Forms
@inject IJSRuntime JS

<PageTitle>Dana · Configuración</PageTitle>

<PageHeader Title="Configuración" Subtitle="Centro de administración de Dana: empresa, usuarios, integraciones, automatizaciones y preferencias personales." />

<div class="settings-toolbar">
    <input type="search" class="settings-search" placeholder="Buscar en la configuración…" value="@_filter" @oninput="e => _filter = e.Value?.ToString() ?? string.Empty" />
</div>

<div class="settings-hub">
    <div class="widget settings-status">
        <div class="widget-title">
            <span>Estado del sistema <span class="badge-soft">@(Env.IsDevelopment() ? "desarrollo" : "producción")</span></span>
            <span class="status-summary @(_pending == 0 ? "ok" : "warn")">@_active de @_status.Count activos@(_pending > 0 ? $" · {_pending} por revisar" : "")</span>
        </div>
        <div class="status-grid">
            @foreach (var s in _status)
            {
                <div class="status-item">
                    <span class="st-dot @s.State"></span>
                    <div class="st-body">
                        <div class="st-label">@s.Label <span class="st-state @s.State">@StateText(s.State)</span></div>
                        <div class="st-detail">@s.Detail</div>
                    </div>
                    @if (s.Href is not null) { <a class="st-action" href="@s.Href">Configurar →</a> }
                </div>
            }
        </div>
        <div class="settings-counters">
            <a href="usuarios" class="counter"><strong>@_users</strong><span>usuarios</span></a>
            <a href="leads" class="counter"><strong>@_leads</strong><span>prospectos</span></a>
            <a href="deals" class="counter"><strong>@_deals</strong><span>negociaciones</span></a>
            <a href="contacts" class="counter"><strong>@_contacts</strong><span>contactos</span></a>
            <a href="companies" class="counter"><strong>@_companies</strong><span>compañías</span></a>
            <a href="pipelines" class="counter"><strong>@_pipelines</strong><span>embudos</span></a>
            <a href="automatizaciones" class="counter"><strong>@_automations</strong><span>automatizaciones</span></a>
            <a href="configuracion/api" class="counter"><strong>@_channels</strong><span>canales API</span></a>
            <a href="formularios" class="counter"><strong>@_forms</strong><span>formularios</span></a>
        </div>
    </div>

    @foreach (var g in Groups.Where(g => g.Items.Any(Visible)))
    {
        <h5 class="settings-group">@g.Title</h5>
        <div class="settings-grid">
            @foreach (var it in g.Items.Where(Visible))
            {
                <a class="settings-card" href="@it.Href">
                    <span class="settings-ico">@IconSvg(it.Icon)</span>
                    <span class="settings-text">
                        <strong>@it.Title @if (it.Admin) { <span class="badge-soft">admin</span> }</strong>
                        <span class="muted">@it.Desc</span>
                    </span>
                </a>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_filter) && !Groups.SelectMany(g => g.Items).Any(Visible))
    {
        <p class="muted">No hay opciones que coincidan con «@_filter».</p>
    }

    <h5 class="settings-group">Preferencias personales</h5>
    <div class="settings-grid">
        <button type="button" class="settings-card" @onclick="ToggleThemeAsync">
            <span class="settings-ico">@IconSvg(_dark ? "sun" : "moon")</span>
            <span class="settings-text"><strong>Apariencia</strong><span class="muted">Ahora: @(_dark ? "modo oscuro" : "modo claro"). Clic para cambiar.</span></span>
        </button>
        <a class="settings-card" href="cuenta/perfil">
            <span class="settings-ico">@IconSvg("user")</span>
            <span class="settings-text"><strong>Mi perfil</strong><span class="muted">Nombre, avatar y contraseña de tu cuenta.</span></span>
        </a>
        <button type="button" class="settings-card" @onclick="OpenMenuCustomizerAsync">
            <span class="settings-ico">@IconSvg("sliders")</span>
            <span class="settings-text"><strong>Personalizar menú</strong><span class="muted">Ocultar, renombrar, reordenar o añadir enlaces al menú lateral.</span></span>
        </button>
        <a class="settings-card" href="tutorial">
            <span class="settings-ico">@IconSvg("help")</span>
            <span class="settings-text"><strong>Tutorial</strong><span class="muted">Cómo funcionan prospectos, negociaciones, contactos y compañías.</span></span>
        </a>
    </div>
</div>

@code {
    private record Item(string Title, string Desc, string Href, string Icon, bool Admin = false);
    private record Group(string Title, Item[] Items);

    private static readonly Group[] Groups =
    [
        new("Empresa y cuenta", [
            new("Empresa y moneda", "Datos de la empresa, moneda base, tipos de cambio y numeración de cotizaciones.", "configuracion/empresa", "building", true),
            new("Usuarios, roles y equipos", "Invitaciones, roles Admin/Usuario, permisos por tablero y equipos.", "usuarios", "users", true),
            new("Auditoría", "Historial de cambios: quién modificó qué y cuándo.", "auditoria", "clock", true),
            new("Papelera", "Restaurar o eliminar definitivamente registros borrados.", "papelera", "trash"),
        ]),
        new("Ventas y flujo de trabajo", [
            new("Embudos (pipelines)", "Etapas de las negociaciones, probabilidades y embudos por línea de negocio.", "pipelines", "list"),
            new("Automatizaciones", "Reglas \"cuando pase X, haz Y\": notificar, mover de etapa, crear tareas, webhooks.", "automatizaciones", "bolt"),
            new("Plantillas de correo", "Correos reutilizables con variables para prospectos y negociaciones.", "plantillas", "mail"),
            new("Documentos", "Contratos, NDA, propuestas, cartas y actas con plantillas, versiones y exportación a Word.", "documentos", "doc"),
            new("Productos y categorías", "Catálogo de productos, categorías, etiquetas e imágenes.", "productos", "box"),
        ]),
        new("Inteligencia artificial", [
            new("Proveedores de IA", "Claves de API de Claude (Anthropic) y ChatGPT (OpenAI), modelos por defecto y límites.", "configuracion/ia", "spark", true),
            new("Agentes", "Asistentes con rol, instrucciones y herramientas sobre los datos del CRM.", "agentes", "robot"),
            new("Oficina virtual", "Espacio 2D donde el equipo y los agentes conviven; acérquese a uno para hablar.", "oficina", "office"),
            new("Telegram", "Hable con los agentes desde Telegram: vincule su chat con su cuenta de Dana.", "agentes/telegram", "send"),
        ]),
        new("Integraciones", [
            new("API y canales", "Recibir prospectos desde su sitio web y tokens de la API REST.", "configuracion/api", "code", true),
            new("API de productos (catálogo)", "Consultar sus productos desde otros sistemas o su web: GET /api/public/products?key=… y /api/v1/products.", "configuracion/api#catalogo", "box", true),
            new("Formularios públicos", "Formularios para incrustar o enlazar que crean prospectos automáticamente.", "formularios", "form"),
            new("Importar datos", "Cargar prospectos, contactos, compañías o negociaciones desde Excel/CSV.", "importar", "import"),
            new("Informes", "Paneles configurables con gráficos y exportación.", "informes", "chart"),
        ]),
    ];

    // Iconos propios de esta página; el resto se toma del conjunto del menú (NavService.Icons).
    private static readonly Dictionary<string, string> ExtraIcons = new()
    {
        ["send"] = "<path d=\"M17 3 9 11M17 3l-5 14-3-6-6-3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>",
        ["user"] = "<circle cx=\"10\" cy=\"7\" r=\"3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M3.5 17c.8-3.2 3.3-5 6.5-5s5.7 1.8 6.5 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>",
        ["sliders"] = "<path d=\"M4 6h12M4 14h12M8 4v4M13 12v4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>",
        ["moon"] = "<path d=\"M16 12.5A6.5 6.5 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>",
        ["sun"] = "<circle cx=\"10\" cy=\"10\" r=\"3.2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.6 4.6l1.4 1.4M14 14l1.4 1.4M4.6 15.4 6 14M14 6l1.4-1.4\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>",
        ["help"] = "<circle cx=\"10\" cy=\"10\" r=\"7.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M8 8a2 2 0 1 1 3 1.7c-.7.4-1 .8-1 1.5M10 14h.01\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>",
    };

    private static MarkupString IconSvg(string key)
    {
        var path = NavService.Icons.GetValueOrDefault(key) ?? ExtraIcons.GetValueOrDefault(key) ?? "";
        return new($"<svg viewBox=\"0 0 20 20\" class=\"settings-svg\" aria-hidden=\"true\">{path}</svg>");
    }

    // State: ok (activo) · warn (atención) · bad (error) · off (opcional, sin configurar)
    private record StatusItem(string Label, string State, string Detail, string? Href = null);

    private bool _isAdmin, _mongoOk, _dark;
    private string _mongoError = "";
    private string _filter = "";
    private AppSettings? _settings;
    private List<StatusItem> _status = new();
    private int _active, _pending;
    private long _users, _leads, _deals, _contacts, _companies, _pipelines, _automations, _channels, _forms;

    private bool Visible(Item it) => (!it.Admin || _isAdmin) && Matches(it);

    private bool Matches(Item it) =>
        string.IsNullOrWhiteSpace(_filter) || (it.Title + " " + it.Desc).Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string StateText(string state) => state switch
    {
        "ok" => "Activo",
        "warn" => "Atención",
        "bad" => "Error",
        _ => "Sin configurar",
    };

    private void BuildStatus()
    {
        _status =
        [
            _mongoOk ? new("Base de datos MongoDB", "ok", "Conectada") : new("Base de datos MongoDB", "bad", _mongoError),
            Email.IsConfigured
                ? new("Correo saliente (SMTP)", "ok", "Remitente: " + Email.From)
                : new("Correo saliente (SMTP)", "warn", "Falta configurar Email:Smtp (servidor y remitente)."),
            Auth.Google.IsConfigured
                ? new("Inicio de sesión con Google", "ok", Auth.Google.AllowedDomains.Count > 0 ? "Solo dominios: " + string.Join(", ", Auth.Google.AllowedDomains) : "Cualquier cuenta de Google")
                : new("Inicio de sesión con Google", "off", "No configurado · Authentication:Google:ClientId"),
            Auth.AllowRegistration
                ? new("Registro público de usuarios", "warn", "Abierto: cualquiera puede crear una cuenta.")
                : new("Registro público de usuarios", "ok", "Cerrado: los usuarios se invitan desde Usuarios."),
            _settings is not null && Agents.AnyConfigured(_settings.Ai)
                ? new("Agentes de IA (Claude / ChatGPT)", "ok", "Clave de API configurada.")
                : new("Agentes de IA (Claude / ChatGPT)", "warn", "Sin clave de API: los agentes no pueden responder.", "configuracion/ia"),
            TelegramBot.IsConfigured
                ? new("Telegram", "ok", string.IsNullOrWhiteSpace(TelegramBot.BotUsername) ? "Bot configurado." : "Bot @" + TelegramBot.BotUsername + ".", "agentes/telegram")
                : new("Telegram", "off", "Sin token · Telegram:BotToken", "agentes/telegram"),
            Twilio.IsConfigured
                ? new("Twilio (SMS y WhatsApp)", "ok", "Credenciales configuradas.")
                : new("Twilio (SMS y WhatsApp)", "off", "Sin credenciales · Twilio:AccountSid y AuthToken"),
            Invoices.IsProviderConfigured
                ? new("Facturación electrónica CR", "ok", "Proveedor: " + Invoices.ProviderName)
                : new("Facturación electrónica CR", "off", "Sin proveedor: solo se pueden crear borradores."),
            new("Moneda base", "ok", $"{_settings?.BaseCurrency} · {_settings?.CompanyName}"),
            new("Plataforma", "ok", $".NET {Environment.Version} · {System.Runtime.InteropServices.RuntimeInformation.OSDescription}"),
        ];
        _active = _status.Count(s => s.State == "ok");
        _pending = _status.Count(s => s.State is "warn" or "bad");
    }

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Me.IsAdminAsync();
        _settings = await Settings.GetAsync();
        try
        {
            await Mongo.Database.RunCommandAsync<MongoDB.Bson.BsonDocument>(new MongoDB.Bson.BsonDocument("ping", 1));
            _mongoOk = true;
        }
        catch (Exception ex) { _mongoError = ex.Message; }
        if (_mongoOk) await LoadCountsAsync();
        BuildStatus();
    }

    private async Task LoadCountsAsync()
    {
        _users = await Users.CountAsync();
        _leads = await Leads.CountAsync();
        _deals = await Deals.CountAsync();
        _contacts = await Contacts.CountAsync();
        _companies = await Companies.CountAsync();
        _pipelines = await Pipelines.CountAsync();
        _automations = await Automations.CountAsync();
        _channels = await Channels.CountAsync();
        _forms = await Forms.CountAsync();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try { _dark = await JS.InvokeAsync<string?>("localStorage.getItem", "dana.theme") == "dark"; StateHasChanged(); } catch { }
    }

    private async Task ToggleThemeAsync()
    {
        _dark = !_dark;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "dana.theme", _dark ? "dark" : "light");
            await JS.InvokeVoidAsync("eval", _dark ? "document.documentElement.dataset.theme='dark'" : "delete document.documentElement.dataset.theme");
        }
        catch { }
    }

    private async Task OpenMenuCustomizerAsync()
    {
        try { await JS.InvokeVoidAsync("eval", "document.querySelector('.nav-customize')?.click()"); } catch { }
    }
}
