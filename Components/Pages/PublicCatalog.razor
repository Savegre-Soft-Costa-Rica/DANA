@page "/catalogo/{Token}"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject ShareLinkService Shares
@inject QuoteService Quotes

<PageTitle>@(_live ? _share!.Title : "Catálogo")</PageTitle>

@if (!_live)
{
    <div class="pub-form">
        <div class="pub-card" style="text-align:center">
            <div style="font-size:2.6rem">🔒</div>
            <h2>Catálogo no disponible</h2>
            <p class="muted">@_reason</p>
        </div>
    </div>
}
else
{
    <div class="pub-catalog" style="--accent:@_share!.AccentColor">
        <header class="pubc-head">
            <div class="pubc-head-in">
                <div class="min-w-0">
                    <h1>@_share.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(_share.Subtitle)) { <p class="pubc-sub">@_share.Subtitle</p> }
                </div>
                <form method="get" action="catalogo/@Token" class="pubc-search">
                    @if (!string.IsNullOrEmpty(Cat) && _share.Category is null) { <input type="hidden" name="cat" value="@Cat" /> }
                    <input name="q" value="@Q" placeholder="Buscar producto o servicio…" aria-label="Buscar" />
                    <button type="submit" class="btn-primary">Buscar</button>
                </form>
            </div>
            @if (_share.Category is null && _cats.Count > 0)
            {
                <nav class="pubc-cats">
                    <a class="pubc-cat @(string.IsNullOrEmpty(Cat) ? "active" : "")" href="@LinkWith(null)">Todo</a>
                    @foreach (var c in _cats)
                    {
                        <a class="pubc-cat @(Cat == c.Name ? "active" : "")" href="@LinkWith(c.Name)" style="--chip:@c.Color">@c.Name</a>
                    }
                </nav>
            }
        </header>

        <main class="pubc-body">
            @if (_items.Count == 0)
            {
                <div class="pub-empty">No hay productos que coincidan con su búsqueda.</div>
            }
            else
            {
                <div class="tiles">
                    @foreach (var p in _items)
                    {
                        var cat = _cats.FirstOrDefault(c => c.Name == p.Category);
                        <article class="tile pubc-tile">
                            <div class="tile-img">
                                @if (p.MainImageId is not null) { <img src="catalog/images/@p.MainImageId" alt="@p.Name" loading="lazy" /> }
                                else { <span class="tile-noimg">📦</span> }
                            </div>
                            <div class="tile-body">
                                <div class="tile-name">@p.Name</div>
                                <div class="tile-price" style="color:var(--accent)">@p.Price.ToString("N2") @p.Currency <small class="muted">/ @p.Unit</small></div>
                                @if (cat is not null) { <span class="badge-pill" style="background:@cat.Color">@cat.Name</span> }
                                @if (!string.IsNullOrWhiteSpace(p.Description)) { <p class="pubc-desc">@p.Description</p> }
                                @if (p.Tags.Count > 0) { <div class="tags">@foreach (var t in p.Tags) { <span class="tag">@t</span> }</div> }
                            </div>
                        </article>
                    }
                </div>
            }
        </main>

        <footer class="pubc-foot">
            <span>@_items.Count producto@(_items.Count == 1 ? "" : "s")</span>
            <span class="muted">Catálogo gestionado con Dana CRM</span>
        </footer>
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = "";
    [SupplyParameterFromQuery(Name = "cat")] public string? Cat { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private ShareLink? _share;
    private bool _live;
    private string _reason = "";
    private List<Product> _items = new();
    private List<ProductCategory> _cats = new();

    protected override async Task OnInitializedAsync()
    {
        _share = await Shares.FindByTokenAsync(Token);
        if (_share is null || _share.Kind != ShareKinds.Catalog) { _reason = "Este enlace no existe o fue revocado."; return; }
        if (!_share.IsEnabled) { _reason = "Este enlace fue detenido por quien lo compartió."; return; }
        if (_share.IsExpired) { _reason = "Este enlace expiró y ya no está disponible."; return; }
        _live = true;

        var category = _share.Category ?? Cat;
        _items = await Quotes.GetCatalogAsync(category, null, Q);

        // Categorías que tienen al menos un producto público (para los filtros)
        var present = (await Quotes.GetCatalogAsync())
            .Select(p => p.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToHashSet();
        _cats = (await Quotes.GetCategoriesAsync()).Where(c => present.Contains(c.Name)).ToList();

        await Shares.RegisterViewAsync(_share);
    }

    private string LinkWith(string? cat)
    {
        var qs = new List<string>();
        if (!string.IsNullOrEmpty(cat)) qs.Add($"cat={Uri.EscapeDataString(cat)}");
        if (!string.IsNullOrEmpty(Q)) qs.Add($"q={Uri.EscapeDataString(Q)}");
        return $"catalogo/{Token}" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }
}
