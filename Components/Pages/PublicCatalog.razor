@page "/catalogo/{Token}"
@attribute [AllowAnonymous]
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Catálogo</PageTitle>

@* La vista es una isla interactiva (carrito + pedido). La página en sí es estática/anónima;
   se desactiva el prerender para cargar el catálogo una sola vez al conectar el circuito. *@
<CatalogStore Token="@Token" @rendermode="_mode" />

@code {
    [Parameter] public string Token { get; set; } = "";
    private static readonly IComponentRenderMode _mode = new InteractiveServerRenderMode(prerender: false);
}
