@page "/leads/new"
@page "/leads/{Id}"
@inject LeadService Leads
@inject PipelineService Pipelines
@inject UserService Users
@inject CurrentUser Me
@inject DrawerService Drawer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DialogService Dialogs
@inject BoardConfigService Configs

<PageTitle>Dana · @(IsNew ? "Nuevo prospecto" : _model.Title)</PageTitle>

@if (_loading)
{
    <p class="muted">Cargando…</p>
    return;
}

<div class="page-head">
    <div>
        <h3>@(IsNew ? "Nuevo prospecto" : _model.Title)</h3>
        <div class="sub">
            <Badge Text="@_status.Name" Color="@_status.Color" />
            @if (!IsNew) { <span class="ms-2">Creado @_model.CreatedAt.ToLocalTime().ToString("g")</span> }
        </div>
    </div>
    <div class="actions">
        @if (!Embedded) { <a class="btn-secondary" href="leads">← Tablero</a> }
        @if (!IsNew && _model.Status != LeadStatuses.Converted)
        {
            <button class="btn-primary" style="background:var(--success)" @onclick="() => _showConvert = !_showConvert">⇄ Convertir</button>
        }
        @if (!IsNew)
        {
            <button class="btn-secondary" @onclick="() => _emailOpen = true" disabled="@string.IsNullOrWhiteSpace(_model.Email)">✉ Enviar correo</button>
            <button class="btn-secondary" @onclick="ArchiveAsync">@(_model.IsArchived ? "↩ Restaurar" : "🗂 Archivar")</button>
            <button class="btn-danger" @onclick="DeleteAsync">Eliminar</button>
        }
    </div>
</div>

@if (_model.IsArchived) { <div class="alert alert-secondary">Este elemento está <strong>archivado</strong>. No aparece en el tablero salvo con el filtro "Archivados".</div> }

@if (_model.Status == LeadStatuses.Converted)
{
    <div class="alert alert-success">
        Este prospecto ya fue <strong>convertido</strong>.
        @if (_model.ConvertedContactId is not null) { <a class="ms-2" href="contacts/@_model.ConvertedContactId">Ver contacto</a> }
        @if (_model.ConvertedCompanyId is not null) { <a class="ms-2" href="companies/@_model.ConvertedCompanyId">Ver compañía</a> }
        @if (_model.ConvertedDealId is not null) { <a class="ms-2" href="deals/@_model.ConvertedDealId">Ver negociación</a> }
    </div>
}

@if (_showConvert)
{
    <div class="card mb-3" style="border-color:var(--success)">
        <div class="card-header">Convertir prospecto</div>
        <div class="card-body">
            <p class="small muted">Se crearán las entidades seleccionadas con los datos del prospecto y éste pasará a estado <em>Convertido</em>.</p>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="cvContact" @bind="_cvContact" />
                <label class="form-check-label" for="cvContact">Crear <strong>Contacto</strong> (@(_model.FullName is { Length: > 0 } ? _model.FullName : _model.Title))@(_model.Contacts.Count(c => !c.IsEmpty) is int n && n > 0 ? $" y {n} contacto(s) adicional(es)" : "")</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="cvCompany" @bind="_cvCompany" disabled="@string.IsNullOrWhiteSpace(_model.CompanyName)" />
                <label class="form-check-label" for="cvCompany">Crear <strong>Compañía</strong> @(string.IsNullOrWhiteSpace(_model.CompanyName) ? "(sin nombre de compañía)" : $"({_model.CompanyName})")</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="cvDeal" @bind="_cvDeal" />
                <label class="form-check-label" for="cvDeal">Crear <strong>Negociación</strong> por <Money Amount="_model.Opportunity" Currency="@_model.Currency" /></label>
            </div>
            @if (_cvDeal)
            {
                <div class="mt-2" style="max-width:320px">
                    <label class="form-label">Embudo</label>
                    <select class="form-select form-select-sm" @bind="_cvPipelineId">
                        @foreach (var p in _pipelines) { <option value="@p.Id">@p.Name @(p.IsDefault ? "(predeterminado)" : "")</option> }
                    </select>
                </div>
            }
            @if (_convertError is not null) { <div class="text-danger small mt-2">@_convertError</div> }
            <div class="mt-3 d-flex gap-2">
                <button class="btn-primary" style="background:var(--success)" @onclick="ConvertAsync" disabled="@(_busy || !(_cvContact || _cvCompany || _cvDeal))">Convertir ahora</button>
                <button class="btn-secondary" @onclick="() => _showConvert = false">Cancelar</button>
            </div>
        </div>
    </div>
}

<div class="item-view @(IsNew ? "single" : "")">
    <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="leadForm">
        <DataAnnotationsValidator />
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Información</span>
                @if (!_editing) { <button type="button" class="btn-secondary btn-sm" @onclick="() => _editing = true">✎ Editar</button> }
            </div>
            <div class="card-body">
                @if (_editing)
                {
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Título *</label>
                        <InputText class="form-control" @bind-Value="_model.Title" placeholder="Ej. Consulta web – Empresa X" />
                        <ValidationMessage For="() => _model.Title" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Estado</label>
                        <InputSelect class="form-select" @bind-Value="_model.Status" disabled="@(_model.Status == LeadStatuses.Converted)">
                            @foreach (var s in LeadStatuses.All.Where(s => s.Id != LeadStatuses.Converted || _model.Status == LeadStatuses.Converted))
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4"><label class="form-label">Nombre</label><InputText class="form-control" @bind-Value="_model.Name" /></div>
                    <div class="col-md-4"><label class="form-label">Apellido</label><InputText class="form-control" @bind-Value="_model.LastName" /></div>
                    <div class="col-md-4"><label class="form-label">Cargo</label><InputText class="form-control" @bind-Value="_model.Position" /></div>
                    <div class="col-md-4"><label class="form-label">Compañía</label><InputText class="form-control" @bind-Value="_model.CompanyName" /></div>
                    <div class="col-md-4"><label class="form-label">Teléfono</label><InputText class="form-control" @bind-Value="_model.Phone" /></div>
                    <div class="col-md-4">
                        <label class="form-label">Correo</label>
                        <InputText class="form-control" @bind-Value="_model.Email" />
                        <ValidationMessage For="() => _model.Email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fuente</label>
                        <InputSelect class="form-select" @bind-Value="_model.Source">
                            <option value="">—</option>
                            @foreach (var s in Catalogs.Sources) { <option value="@s">@s</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Oportunidad</label>
                        <InputNumber class="form-control" @bind-Value="_model.Opportunity" />
                        <ValidationMessage For="() => _model.Opportunity" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Moneda</label>
                        <InputSelect class="form-select" @bind-Value="_model.Currency">
                            @foreach (var c in Catalogs.Currencies) { <option value="@c">@c</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Responsable</label>
                        <InputSelect class="form-select" @bind-Value="_model.AssignedTo">
                            <option value="">Sin asignar</option>
                            @foreach (var p in _people) { <option value="@p">@p</option> }
                        </InputSelect>
                    </div>
                    <div class="col-12"><label class="form-label">Comentarios</label><InputTextArea class="form-control" rows="3" @bind-Value="_model.Comments" /></div>

                    @* ----- Campos personalizados (compartidos con el tablero de prospectos) ----- *@
                    @foreach (var col in _customCols)
                    {
                        <div class="@(col.Type == ColumnType.LongText ? "col-12" : "col-md-4")">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>@col.Title</span>
                                @if (_isAdmin)
                                {
                                    <button type="button" class="small" style="border:0;background:none;color:var(--danger,#e2445c);cursor:pointer;padding:0" title="Eliminar campo" @onclick="() => DeleteFieldAsync(col)">✕</button>
                                }
                            </label>
                            @switch (col.Type)
                            {
                                case ColumnType.LongText:
                                    <textarea class="form-control" rows="2" value="@col.EditText(_model)" @onchange="e => OnCustomText(col, e)"></textarea>
                                    break;
                                case ColumnType.Number:
                                case ColumnType.Money:
                                    <input type="number" step="any" class="form-control" value="@col.EditText(_model)" @onchange="e => OnCustomText(col, e)" />
                                    break;
                                case ColumnType.Date:
                                    <input type="date" class="form-control" value="@col.EditText(_model)" @onchange="e => OnCustomText(col, e)" />
                                    break;
                                case ColumnType.Checkbox:
                                    <div><input type="checkbox" class="form-check-input" checked="@(col.GetValue(_model) is true)" @onchange="e => OnCustomCheck(col, e)" /></div>
                                    break;
                                case ColumnType.Status:
                                case ColumnType.Select:
                                case ColumnType.Person:
                                    <select class="form-select" value="@(col.GetValue(_model)?.ToString())" @onchange="e => OnCustomSelect(col, e)">
                                        <option value="">—</option>
                                        @foreach (var o in col.Options) { <option value="@o.Value">@o.Label</option> }
                                    </select>
                                    break;
                                default:
                                    <input type="@(col.Type == ColumnType.Email ? "email" : col.Type == ColumnType.Phone ? "tel" : "text")" class="form-control" value="@col.EditText(_model)" @onchange="e => OnCustomText(col, e)" />
                                    break;
                            }
                        </div>
                    }

                    @if (_isAdmin)
                    {
                        <div class="col-12">
                            @if (!_addFieldOpen)
                            {
                                <button type="button" class="btn-secondary btn-sm" @onclick="() => _addFieldOpen = true">+ Agregar campo</button>
                            }
                            else
                            {
                                <div class="d-flex gap-2 align-items-end flex-wrap p-2" style="background:var(--surface-head);border-radius:8px">
                                    <div>
                                        <label class="form-label small">Nombre del campo</label>
                                        <input class="form-control form-control-sm" style="min-width:180px" @bind="_newFieldTitle" @bind:event="oninput" placeholder="Ej. RUC, Cantón…" />
                                    </div>
                                    <div>
                                        <label class="form-label small">Tipo</label>
                                        <select class="form-select form-select-sm" @bind="_newFieldType">
                                            @foreach (var (type, label) in ColumnTypes.Creatable) { <option value="@type">@label</option> }
                                        </select>
                                    </div>
                                    <button type="button" class="btn-primary btn-sm" @onclick="AddFieldAsync" disabled="@string.IsNullOrWhiteSpace(_newFieldTitle)">Agregar</button>
                                    <button type="button" class="btn-secondary btn-sm" @onclick="() => _addFieldOpen = false">Cancelar</button>
                                </div>
                                <div class="small muted mt-1">Los campos personalizados también aparecen como columnas en el tablero de prospectos.</div>
                            }
                        </div>
                    }
                </div>

                @* ----- Contactos adicionales ----- *@
                <div class="mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Contactos adicionales @(_model.Contacts.Count > 0 ? $"({_model.Contacts.Count})" : "")</strong>
                        <button type="button" class="btn-secondary btn-sm" @onclick="() => _model.Contacts.Add(new LeadContact())">+ Agregar contacto</button>
                    </div>
                    @if (_model.Contacts.Count == 0)
                    {
                        <p class="muted small mb-0">Sin contactos adicionales. El contacto principal son los campos de arriba; agregue más personas de la misma cuenta aquí.</p>
                    }
                    @foreach (var c in _model.Contacts)
                    {
                        <div class="row g-2 align-items-end mb-2 pb-2 border-bottom">
                            <div class="col-md-3"><label class="form-label small">Nombre</label><InputText class="form-control form-control-sm" @bind-Value="c.Name" /></div>
                            <div class="col-md-2"><label class="form-label small">Apellido</label><InputText class="form-control form-control-sm" @bind-Value="c.LastName" /></div>
                            <div class="col-md-2"><label class="form-label small">Cargo</label><InputText class="form-control form-control-sm" @bind-Value="c.Position" /></div>
                            <div class="col-md-2"><label class="form-label small">Teléfono</label><InputText class="form-control form-control-sm" @bind-Value="c.Phone" /></div>
                            <div class="col-md-2"><label class="form-label small">Correo</label><InputText class="form-control form-control-sm" @bind-Value="c.Email" /></div>
                            <div class="col-md-1 text-end"><button type="button" class="btn-danger btn-sm" title="Quitar" @onclick="() => _model.Contacts.Remove(c)">✕</button></div>
                        </div>
                    }
                </div>
                }
                else
                {
                    <div class="info-grid">
                        <FieldView Label="Título" Value="@_model.Title" Wide="true" />
                        <FieldView Label="Estado"><Badge Text="@_status.Name" Color="@_status.Color" /></FieldView>
                        <FieldView Label="Nombre" Value="@_model.Name" />
                        <FieldView Label="Apellido" Value="@_model.LastName" />
                        <FieldView Label="Cargo" Value="@_model.Position" />
                        <FieldView Label="Compañía" Value="@_model.CompanyName" />
                        <FieldView Label="Teléfono" Value="@_model.Phone" />
                        <FieldView Label="Correo" Value="@_model.Email" />
                        <FieldView Label="Fuente" Value="@_model.Source" />
                        <FieldView Label="Oportunidad"><Money Amount="_model.Opportunity" Currency="@_model.Currency" /></FieldView>
                        <FieldView Label="Responsable" Value="@_model.AssignedTo" />
                        @foreach (var col in _customCols) { <FieldView Label="@col.Title" Value="@CustomDisplay(col)" /> }
                        <FieldView Label="Comentarios" Value="@_model.Comments" Wide="true" />
                    </div>
                    @if (_model.Contacts.Count > 0)
                    {
                        <div class="mt-4">
                            <strong>Contactos adicionales (@_model.Contacts.Count)</strong>
                            @foreach (var c in _model.Contacts)
                            {
                                <div class="small mt-1 pb-1 border-bottom">@c.FullName@(string.IsNullOrWhiteSpace(c.Position) ? "" : $" · {c.Position}")@(string.IsNullOrWhiteSpace(c.Phone) ? "" : $" · {c.Phone}")@(string.IsNullOrWhiteSpace(c.Email) ? "" : $" · {c.Email}")</div>
                            }
                        </div>
                    }
                }
            </div>
            @if (_editing)
            {
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <span class="muted small">@(_saved ? "✓ Guardado" : "")</span>
                    <span class="d-flex gap-2">
                        <button type="button" class="btn-secondary" @onclick="CancelEdit">Cancelar</button>
                        <button type="submit" class="btn-primary" disabled="@_busy">Guardar</button>
                    </span>
                </div>
            }
        </div>
    </EditForm>

    @if (!IsNew)
    {
        <div>
        <TaskList EntityType="lead" EntityId="@_model.Id" EntityTitle="@(_model.Title)" />
        @if (!IsNew) { <DocumentsCard EntityType="lead" EntityId="@_model.Id" /> }
        @if (!IsNew) { <FilesCard EntityType="lead" EntityId="@_model.Id" /> }
        <div class="card mt-3">
            <div class="card-header">Actualizaciones</div>
            <div class="card-body">
                <Updates EntityType="lead" EntityId="@_model.Id" EntityTitle="@(_model.Title)" />
            </div>
        </div>
        </div>
    }
</div>

<EmailComposer @bind-Open="_emailOpen" To="@(_model.Email)" Context="@(new EmailContext(_model.Name, _model.LastName, _model.CompanyName, _model.Email, _model.Title, string.Empty))" EntityType="lead" EntityId="@(_model.Id ?? string.Empty)" EntityTitle="@(_model.Title)" />

@code {
    private bool _emailOpen;
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Embedded { get; set; }
    private bool IsNew => string.IsNullOrEmpty(Id);

    private Lead _model = new();
    private LeadStatus _status => LeadStatuses.Get(_model.Status);
    private List<Pipeline> _pipelines = new();
    private List<string> _people = new();
    private bool _loading = true;

    // Campos personalizados (compartidos con el tablero "leads")
    private BoardConfig _config = new();
    private List<BoardColumn<Lead>> _customCols = new();
    private bool _isAdmin;
    private bool _addFieldOpen;
    private string _newFieldTitle = "";
    private ColumnType _newFieldType = ColumnType.Text;
    private bool _busy, _saved;
    private bool _editing;
    private bool _showConvert;
    private bool _cvContact = true, _cvCompany = true, _cvDeal = true;
    private string? _cvPipelineId;
    private string? _convertError;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _pipelines = await Pipelines.GetAllAsync();
        _people = (await Users.GetAllAsync()).Where(u => u.IsActive).Select(u => u.Name).OrderBy(n => n).ToList();
        _isAdmin = await Me.IsAdminAsync();
        _config = await Configs.GetAsync("leads");
        RebuildCustomCols();
        _cvPipelineId ??= (_pipelines.FirstOrDefault(p => p.IsDefault) ?? _pipelines.FirstOrDefault())?.Id;
        if (IsNew)
        {
            _model = new Lead { AssignedTo = await Me.NameAsync() };
        }
        else
        {
            var found = await Leads.GetAsync(Id);
            if (found is null) { Nav.NavigateTo("leads"); return; }
            _model = found;
            _cvCompany = !string.IsNullOrWhiteSpace(_model.CompanyName);
        }
        _editing = IsNew;
        _loading = false;
    }

    private async Task CancelEdit()
    {
        if (IsNew) { if (Embedded) await Drawer.CloseAsync(); else Nav.NavigateTo("leads"); return; }
        var found = await Leads.GetAsync(Id);
        if (found is not null) _model = found;
        _editing = false;
    }

    private string? CustomDisplay(BoardColumn<Lead> col)
    {
        if (col.GetValue(_model) is bool b) return b ? "Sí" : "No";
        var s = col.EditText(_model);
        if (string.IsNullOrWhiteSpace(s)) return null;
        return col.Options is { Count: > 0 } ? col.Options.FirstOrDefault(o => o.Value == s)?.Label ?? s : s;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var wasNew = IsNew;
            await Leads.SaveAsync(_model, await Me.NameAsync());
            _saved = true;
            _editing = false;
            if (Embedded)
            {
                await Drawer.NotifyChangedAsync();
                if (wasNew) Drawer.Open<LeadEdit>(_model.Id, "Prospecto");
            }
            else if (wasNew) Nav.NavigateTo($"leads/{_model.Id}");
        }
        finally { _busy = false; }
    }

    private async Task ConvertAsync()
    {
        _busy = true;
        _convertError = null;
        try
        {
            var author = await Me.NameAsync();
            await Leads.SaveAsync(_model, author);
            await Leads.ConvertAsync(_model, new ConvertOptions(_cvContact, _cvCompany, _cvDeal, _cvPipelineId), author);
            _showConvert = false;
            if (Embedded) await Drawer.NotifyChangedAsync();
            if (_model.ConvertedDealId is not null) Nav.NavigateTo($"deals/{_model.ConvertedDealId}");
        }
        catch (Exception ex) { _convertError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (!await Dialogs.ConfirmAsync($"¿Eliminar el prospecto \"{_model.Title}\"?")) return;
        await Leads.DeleteAsync(_model.Id!, await Me.NameAsync());
        if (Embedded) { await Drawer.NotifyChangedAsync(); await Drawer.CloseAsync(); }
        else Nav.NavigateTo("leads");
    }

    private async Task ArchiveAsync()
    {
        _model.IsArchived = !_model.IsArchived;
        await Leads.SaveAsync(_model, await Me.NameAsync());
        if (Embedded) { await Drawer.NotifyChangedAsync(); await Drawer.CloseAsync(); }
    }

    // ----- campos personalizados -----
    private void RebuildCustomCols() =>
        _customCols = _config.CustomColumns.Select(d => BoardColumn<Lead>.FromCustom(d, _people)).ToList();

    private void OnCustomText(BoardColumn<Lead> col, ChangeEventArgs e) => col.SetFromText(_model, e.Value?.ToString() ?? "");
    private void OnCustomSelect(BoardColumn<Lead> col, ChangeEventArgs e) => col.SetValue?.Invoke(_model, e.Value?.ToString());
    private void OnCustomCheck(BoardColumn<Lead> col, ChangeEventArgs e) => col.SetValue?.Invoke(_model, e.Value is true);

    private async Task AddFieldAsync()
    {
        if (!_isAdmin || string.IsNullOrWhiteSpace(_newFieldTitle)) return;
        var def = new CustomColumnDef
        {
            Title = _newFieldTitle.Trim(),
            Type = _newFieldType.ToString(),
            Width = _newFieldType is ColumnType.LongText ? 220 : 150
        };
        if (_newFieldType is ColumnType.Status or ColumnType.Select)
            def.Options =
            [
                new StatusOptionDef { Value = "op1", Label = "Opción 1", Color = "#00c875" },
                new StatusOptionDef { Value = "op2", Label = "Opción 2", Color = "#fdab3d" },
                new StatusOptionDef { Value = "op3", Label = "Opción 3", Color = "#e2445c" },
            ];
        _config.CustomColumns.Add(def);
        await Configs.SaveAsync(_config);
        RebuildCustomCols();
        _newFieldTitle = "";
        _newFieldType = ColumnType.Text;
        _addFieldOpen = false;
    }

    private async Task DeleteFieldAsync(BoardColumn<Lead> col)
    {
        if (!_isAdmin || col.CustomId is null) return;
        if (!await Dialogs.ConfirmAsync($"¿Eliminar el campo \"{col.Title}\"? Los valores guardados dejarán de mostrarse.")) return;
        _config.CustomColumns.RemoveAll(d => d.Id == col.CustomId);
        _config.HiddenColumns.Remove(col.Key);
        _config.ColumnOrder.Remove(col.Key);
        _config.LabelOverrides.Remove(col.Key);
        await Configs.SaveAsync(_config);
        RebuildCustomCols();
    }
}
