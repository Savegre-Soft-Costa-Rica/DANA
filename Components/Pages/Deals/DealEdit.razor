@page "/deals/new"
@page "/deals/{Id}"
@inject DealService Deals
@inject QuoteService Quotes
@inject PipelineService Pipelines
@inject IScoringService Score
@inject IRepository<Contact> Contacts
@inject IRepository<Company> Companies
@inject UserService Users
@inject CurrentUser Me
@inject DrawerService Drawer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject DialogService Dialogs

<PageTitle>Dana · @(IsNew ? "Nueva negociación" : _model.Title)</PageTitle>

@if (_loading)
{
    <p class="muted">Cargando…</p>
    return;
}

<div class="page-head">
    <div>
        <h3>@(IsNew ? "Nueva negociación" : _model.Title)</h3>
        <div class="sub">
            @if (CurrentStage is not null) { <Badge Text="@CurrentStage.Name" Color="@CurrentStage.Color" /> }
            <span class="ms-2">@CurrentPipeline?.Name</span>
            @if (!IsNew) { <span class="ms-2">· Creada @_model.CreatedAt.ToLocalTime().ToString("g")</span> }
            @if (_model.ClosedAt is not null) { <span class="ms-2">· Cerrada @_model.ClosedAt.Value.ToLocalTime().ToString("g")</span> }
        </div>
    </div>
    <div class="actions">
        @if (!Embedded) { <a class="btn-secondary" href="deals/board/@_model.PipelineId">← Tablero</a> }
        @if (!IsNew) { <CopyLink Path="@($"deals/{_model.Id}")" /> }
        @if (!ReadOnly && !IsNew && _model.Amount > 0) { <PayLinkButton Amount="_model.Amount" Currency="@_model.Currency" Description="@_model.Title" DealId="@_model.Id" ContactId="@_model.ContactId" CompanyId="@_model.CompanyId" /> }
        @if (!ReadOnly && !IsNew) { <button class="btn-secondary" @onclick="() => _emailOpen = true" disabled="@string.IsNullOrWhiteSpace(DealEmail)">✉ Correo al contacto</button> <button class="btn-secondary" @onclick="DuplicateAsync" disabled="@_busy">⧉ Duplicar</button> <button class="btn-secondary" @onclick="ArchiveAsync">@(_model.IsArchived ? "↩ Restaurar" : "🗂 Archivar")</button> <button class="btn-danger" @onclick="DeleteAsync">Eliminar</button> }
    </div>
</div>

@if (_error is not null) { <div class="alert alert-danger">@_error</div> }

@if (_model.IsArchived) { <div class="alert alert-secondary">Este elemento está <strong>archivado</strong>. No aparece en el tablero salvo con el filtro "Archivados".</div> }

<div class="item-view @(IsNew ? "single" : "")">
    <div>
        <EditForm Model="_model" OnValidSubmit="SaveAsync" FormName="dealForm">
            <DataAnnotationsValidator />
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Información</span>
                    @if (!_editing && !ReadOnly) { <button type="button" class="btn-secondary btn-sm" @onclick="() => _editing = true">✎ Editar</button> }
                </div>
                <div class="card-body">
                    @if (_editing)
                    {
                    @if (CurrentPipeline is not null)
                    {
                        <div class="stage-bar mb-3">
                            @foreach (var s in CurrentPipeline.OrderedStages)
                            {
                                var active = s.Id == _model.StageId;
                                <button type="button" class="stage-step @(active ? "active" : "")"
                                        style="@(active ? $"background:{s.Color};border-color:{s.Color}" : $"border-color:{s.Color}")"
                                        @onclick="() => _model.StageId = s.Id">@s.Name</button>
                            }
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Título *</label>
                            <InputText class="form-control" @bind-Value="_model.Title" />
                            <ValidationMessage For="() => _model.Title" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tipo</label>
                            <InputSelect class="form-select" @bind-Value="_model.Type">
                                <option value="">—</option>
                                @foreach (var t in Catalogs.DealTypes) { <option value="@t">@t</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Embudo *</label>
                            <select class="form-select" value="@_model.PipelineId" @onchange="OnPipelineChanged">
                                @foreach (var p in _pipelines) { <option value="@p.Id">@p.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Etapa *</label>
                            <InputSelect class="form-select" @bind-Value="_model.StageId">
                                @if (CurrentPipeline is not null)
                                {
                                    foreach (var s in CurrentPipeline.OrderedStages) { <option value="@s.Id">@s.Name</option> }
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contacto</label>
                            <SearchSelect TItem="Contact" Items="FilteredContacts"
                                          IdFor="c => c.Id!" LabelFor="c => c.FullName" SubFor="ContactSub"
                                          Value="_model.ContactId" ValueChanged="OnContactChanged"
                                          Placeholder="— Sin contacto —" EmptyText="Sin contactos" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Compañía</label>
                            <SearchSelect TItem="Company" Items="FilteredCompanies"
                                          IdFor="c => c.Id!" LabelFor="c => c.Title" SubFor="CompanySub"
                                          Value="_model.CompanyId" ValueChanged="OnCompanyChanged"
                                          Placeholder="— Sin compañía —" EmptyText="Sin compañías" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Importe</label>
                            <InputNumber class="form-control" @bind-Value="_model.Amount" />
                            <ValidationMessage For="() => _model.Amount" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Moneda</label>
                            <InputSelect class="form-select" @bind-Value="_model.Currency">
                                @foreach (var c in Catalogs.Currencies) { <option value="@c">@c</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Probabilidad (%)</label>
                            <InputNumber class="form-control" @bind-Value="_model.Probability" />
                            <ValidationMessage For="() => _model.Probability" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cierre previsto</label>
                            <InputDate class="form-control" @bind-Value="_model.ExpectedCloseDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Fuente</label>
                            <InputSelect class="form-select" @bind-Value="_model.Source">
                                <option value="">—</option>
                                @foreach (var s in Catalogs.Sources) { <option value="@s">@s</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Responsable</label>
                            <InputSelect class="form-select" @bind-Value="_model.AssignedTo">
                                <option value="">Sin asignar</option>
                                @foreach (var p in _people) { <option value="@p">@p</option> }
                            </InputSelect>
                        </div>
                        <div class="col-12"><label class="form-label">Comentarios</label><InputTextArea class="form-control" rows="3" @bind-Value="_model.Comments" /></div>
                    </div>
                    }
                    else
                    {
                        <div class="info-grid">
                            <FieldView Label="Título" Value="@_model.Title" Wide="true" />
                            <FieldView Label="Tipo" Value="@_model.Type" />
                            <FieldView Label="Embudo" Value="@CurrentPipeline?.Name" />
                            <FieldView Label="Etapa">@if (CurrentStage is not null) { <Badge Text="@CurrentStage.Name" Color="@CurrentStage.Color" /> } else { <span>—</span> }</FieldView>
                            <FieldView Label="Prioridad" Wide="true">@{ var _sc = Score.ScoreDeal(_model, CurrentPipeline); }<ScoreBadge Result="_sc" /> <span class="muted small ms-2">💡 @_sc.NextAction</span></FieldView>
                            <FieldView Label="Contacto" Value="@(_contacts.FirstOrDefault(c => c.Id == _model.ContactId)?.FullName)" />
                            <FieldView Label="Compañía" Value="@(_companies.FirstOrDefault(c => c.Id == _model.CompanyId)?.Title)" />
                            <FieldView Label="Importe"><Money Amount="_model.Amount" Currency="@_model.Currency" /></FieldView>
                            <FieldView Label="Probabilidad" Value="@($"{_model.Probability}%")" />
                            <FieldView Label="Cierre previsto" Value="@(_model.ExpectedCloseDate?.ToString("d"))" />
                            <FieldView Label="Fuente" Value="@_model.Source" />
                            <FieldView Label="Responsable" Value="@_model.AssignedTo" />
                            <FieldView Label="Comentarios" Value="@_model.Comments" Wide="true" />
                        </div>
                    }
                </div>
                @if (_editing)
                {
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="muted small">@(_saved ? "✓ Guardado" : "")</span>
                        <span class="d-flex gap-2">
                            <button type="button" class="btn-secondary" @onclick="CancelEdit">Cancelar</button>
                            <button type="submit" class="btn-primary" disabled="@_busy">Guardar</button>
                        </span>
                    </div>
                }
            </div>
        </EditForm>

        @if (!IsNew)
        {
            <div class="card mt-3">
                <div class="card-header"><span>Cotizaciones <span class="muted">(@_quotes.Count)</span></span><button class="btn-secondary btn-sm" @onclick="NewQuoteAsync">+ Cotización</button></div>
                <div class="card-body">
                    @if (_quotes.Count == 0) { <div class="muted">Sin cotizaciones. Cree una a partir de los productos del catálogo.</div> }
                    <ul class="list-rows">
                        @foreach (var q in _quotes)
                        {
                            var st = QuoteStatuses.Get(q.Status);
                            <li><span><a href="cotizaciones/@q.Id"><strong>@q.Number</strong></a> @q.Title <Badge Text="@st.Label" Color="@st.Color" /></span><span>@q.Total.ToString("N2") @q.Currency <a class="ms-1" href="cotizaciones/@q.Id/imprimir" target="_blank" title="Imprimir">🖨</a></span></li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (!IsNew) { <DocumentsCard EntityType="deal" EntityId="@_model.Id" /> }
        @if (!IsNew) { <FilesCard EntityType="deal" EntityId="@_model.Id" /> }

        @if (!IsNew && _model.History.Count > 0)
        {
            <div class="card mt-3">
                <div class="card-header">Historial de etapas</div>
                <div class="card-body">
                    <ul class="timeline">
                        @foreach (var h in _model.History.OrderByDescending(h => h.At))
                        {
                            <li>
                                <div>@if (h.FromStageName is not null) { <span class="muted">@h.FromStageName →</span> } <strong>@h.ToStageName</strong></div>
                                <div class="when">@h.At.ToLocalTime().ToString("g")</div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

    @if (!IsNew)
    {
        <div>
        <TaskList EntityType="deal" EntityId="@_model.Id" EntityTitle="@(_model.Title)" />
        <div class="card mt-3">
            <div class="card-header">Actualizaciones</div>
            <div class="card-body">
                <Updates EntityType="deal" EntityId="@_model.Id" EntityTitle="@(_model.Title)" />
            </div>
        </div>
        </div>
    }
</div>

<EmailComposer @bind-Open="_emailOpen" To="@DealEmail" Context="@(new EmailContext(_contacts.FirstOrDefault(c => c.Id == _model.ContactId)?.Name, _contacts.FirstOrDefault(c => c.Id == _model.ContactId)?.LastName, _companies.FirstOrDefault(c => c.Id == _model.CompanyId)?.Title, DealEmail, _model.Title, string.Empty))" EntityType="deal" EntityId="@(_model.Id ?? string.Empty)" EntityTitle="@_model.Title" />

@code {
    private bool _emailOpen;
    private List<Quote> _quotes = new();
    private string? DealEmail => _contacts.FirstOrDefault(c => c.Id == _model.ContactId)?.Email ?? _companies.FirstOrDefault(c => c.Id == _model.CompanyId)?.Email;
    [Parameter] public string? Id { get; set; }
    [CascadingParameter(Name = "ReadOnly")] private bool ReadOnly { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [SupplyParameterFromQuery(Name = "pipelineId")] public string? QueryPipelineId { get; set; }
    [SupplyParameterFromQuery(Name = "contactId")] public string? QueryContactId { get; set; }
    [SupplyParameterFromQuery(Name = "companyId")] public string? QueryCompanyId { get; set; }

    private bool IsNew => string.IsNullOrEmpty(Id);

    private Deal _model = new();
    private List<Pipeline> _pipelines = new();
    private List<Contact> _contacts = new();
    private List<Company> _companies = new();
    private List<string> _people = new();
    private bool _loading = true;
    private bool _busy, _saved;
    private bool _editing;
    private string? _error;

    private Pipeline? CurrentPipeline => _pipelines.FirstOrDefault(p => p.Id == _model.PipelineId);
    private Stage? CurrentStage => CurrentPipeline?.GetStage(_model.StageId);

    // Filtrado cruzado contacto <-> compañía (el contacto pertenece a una compañía vía Contact.CompanyId).
    private IReadOnlyList<Contact> FilteredContacts =>
        string.IsNullOrEmpty(_model.CompanyId) ? _contacts : _contacts.Where(c => c.CompanyId == _model.CompanyId).ToList();

    private IReadOnlyList<Company> FilteredCompanies
    {
        get
        {
            var compId = _contacts.FirstOrDefault(c => c.Id == _model.ContactId)?.CompanyId;
            return string.IsNullOrEmpty(_model.ContactId) || string.IsNullOrEmpty(compId)
                ? _companies
                : _companies.Where(c => c.Id == compId).ToList();
        }
    }

    private string? ContactSub(Contact c) => _companies.FirstOrDefault(x => x.Id == c.CompanyId)?.Title ?? c.Email;
    private string? CompanySub(Company c) => c.Email;

    private void OnContactChanged(string? id)
    {
        _model.ContactId = id;
        // Al elegir un contacto, autocompleta su compañía (si tiene).
        if (!string.IsNullOrEmpty(id))
        {
            var comp = _contacts.FirstOrDefault(c => c.Id == id)?.CompanyId;
            if (!string.IsNullOrEmpty(comp)) _model.CompanyId = comp;
        }
    }

    private void OnCompanyChanged(string? id)
    {
        _model.CompanyId = id;
        // Si el contacto actual no pertenece a esta compañía, se limpia para respetar el filtro.
        if (!string.IsNullOrEmpty(id))
        {
            var c = _contacts.FirstOrDefault(x => x.Id == _model.ContactId);
            if (c is not null && c.CompanyId != id) _model.ContactId = null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _pipelines = await Pipelines.GetAllAsync();
        if (_pipelines.Count == 0) { await Pipelines.GetDefaultAsync(); _pipelines = await Pipelines.GetAllAsync(); }
        _contacts = (await Contacts.GetAllAsync()).OrderBy(c => c.FullName).ToList();
        _companies = (await Companies.GetAllAsync()).OrderBy(c => c.Title).ToList();
        _people = (await Users.GetAllAsync()).Where(u => u.IsActive).Select(u => u.Name).OrderBy(n => n).ToList();

        if (IsNew)
        {
            var pipeline = _pipelines.FirstOrDefault(p => p.Id == QueryPipelineId) ?? _pipelines.FirstOrDefault(p => p.IsDefault) ?? _pipelines[0];
            _model = new Deal
            {
                PipelineId = pipeline.Id!,
                StageId = pipeline.FirstStage?.Id ?? "",
                ContactId = string.IsNullOrEmpty(QueryContactId) ? null : QueryContactId,
                CompanyId = string.IsNullOrEmpty(QueryCompanyId) ? null : QueryCompanyId,
                AssignedTo = await Me.NameAsync()
            };
            if (_model.CompanyId is null && _model.ContactId is not null)
                _model.CompanyId = _contacts.FirstOrDefault(c => c.Id == _model.ContactId)?.CompanyId;
        }
        else
        {
            var found = await Deals.GetAsync(Id);
            if (found is null) { Nav.NavigateTo("deals"); return; }
            _model = found;
            _quotes = await Quotes.GetForDealAsync(_model.Id!);
        }
        _editing = IsNew;
        _loading = false;
    }

    private async Task CancelEdit()
    {
        if (IsNew) { if (Embedded) await Drawer.CloseAsync(); else Nav.NavigateTo($"deals/board/{_model.PipelineId}"); return; }
        var found = await Deals.GetAsync(Id);
        if (found is not null) _model = found;
        _editing = false;
    }

    private void OnPipelineChanged(ChangeEventArgs e)
    {
        _model.PipelineId = e.Value?.ToString() ?? "";
        _model.StageId = CurrentPipeline?.FirstStage?.Id ?? "";
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (string.IsNullOrEmpty(_model.ContactId)) _model.ContactId = null;
            if (string.IsNullOrEmpty(_model.CompanyId)) _model.CompanyId = null;
            var wasNew = IsNew;
            await Deals.SaveAsync(_model, await Me.NameAsync());
            _saved = true;
            _editing = false;
            if (Embedded)
            {
                await Drawer.NotifyChangedAsync();
                if (wasNew) Drawer.Open<DealEdit>(_model.Id, "Negociación");
            }
            else if (wasNew) Nav.NavigateTo($"deals/{_model.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task NewQuoteAsync()
    {
        var q = await Quotes.CreateForDealAsync(_model, await Me.NameAsync());
        Nav.NavigateTo($"cotizaciones/{q.Id}");
    }

    private async Task DuplicateAsync()
    {
        if (!await Dialogs.ConfirmAsync($"¿Duplicar la negociación \"{_model.Title}\"?")) return;
        _busy = true;
        _error = null;
        try
        {
            var author = await Me.NameAsync();
            var copy = Entity.Clone(_model);
            copy.IsArchived = false;
            copy.CreatedBy = author;
            // Misma lógica de copia que el tablero (InsertCopyAsync): título, historial y cierre limpios.
            copy.Title += " (copia)";
            copy.History = new();
            copy.ClosedAt = null;
            copy.LeadId = null;
            await Deals.SaveAsync(copy, author);
            if (Embedded) { await Drawer.NotifyChangedAsync(); Drawer.Open<DealEdit>(copy.Id, "Negociación"); }
            else Nav.NavigateTo($"deals/{copy.Id}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (!await Dialogs.ConfirmAsync($"¿Eliminar la negociación \"{_model.Title}\"?")) return;
        await Deals.DeleteAsync(_model.Id!, await Me.NameAsync());
        if (Embedded) { await Drawer.NotifyChangedAsync(); await Drawer.CloseAsync(); }
        else Nav.NavigateTo($"deals/board/{_model.PipelineId}");
    }

    private async Task ArchiveAsync()
    {
        _model.IsArchived = !_model.IsArchived;
        await Deals.SaveAsync(_model, await Me.NameAsync());
        if (Embedded) { await Drawer.NotifyChangedAsync(); await Drawer.CloseAsync(); }
    }
}
