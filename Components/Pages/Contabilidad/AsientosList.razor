@page "/contabilidad/asientos"
@using Dana.Services.Accounting
@inject AccountingService Accounting
@inject DialogService Dialogs
@inject CurrentUser Me

<PageTitle>Dana · Libro diario</PageTitle>

<PageHeader Title="Libro diario" Subtitle="Asientos de partida doble. El total de débitos debe igualar al de créditos.">
    <Actions>
        <a class="btn-secondary" href="contabilidad/cuentas">Plan de cuentas</a>
        @if (_isAdmin)
        {
            <button class="btn-secondary" @onclick="StartWizard" disabled="@(_postable.Count == 0)">✨ Asistente</button>
            <button class="btn-primary" @onclick="NewEntry" disabled="@(_postable.Count == 0)">+ Nuevo asiento</button>
        }
    </Actions>
</PageHeader>

@if (_msg is not null) { <div class="alert alert-info py-2 small">@_msg</div> }
@if (_err is not null) { <div class="alert alert-danger py-2 small">@_err</div> }
@if (_postable.Count == 0) { <div class="alert alert-warning py-2 small">Primero cree cuentas de detalle en el <a href="contabilidad/cuentas">plan de cuentas</a>.</div> }
@if (!_isAdmin) { <div class="alert alert-info py-2 small">Solo lectura: crear, registrar, anular y eliminar asientos está reservado a administradores.</div> }

@if (_wizard && _isAdmin)
{
    <AsientoWizard Postable="_postable" OnFinished="WizardDone" OnCancel="() => _wizard = false" />
}

@if (_edit is not null)
{
    <div class="card mb-3">
        <div class="card-header">@(_edit.Number > 0 ? $"Asiento N.º {_edit.Number}" : _edit.Id is null ? "Nuevo asiento" : "Asiento (borrador)")</div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-3"><label class="form-label">Fecha *</label><input type="date" class="form-control" @bind="_edit.Date" /></div>
                <div class="col-md-6"><label class="form-label">Descripción / glosa *</label><input class="form-control" @bind="_edit.Description" /></div>
                <div class="col-md-3"><label class="form-label">Referencia</label><input class="form-control" @bind="_edit.Reference" placeholder="Factura, cheque…" /></div>
            </div>

            <table class="table table-sm align-middle">
                <thead><tr><th style="width:38%">Cuenta</th><th>Detalle</th><th class="text-end" style="width:130px">Débito</th><th class="text-end" style="width:130px">Crédito</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in _edit.Lines)
                    {
                        <tr>
                            <td>
                                <select class="form-select form-select-sm" @bind="l.AccountCode">
                                    <option value="">— cuenta —</option>
                                    @foreach (var a in _postable) { <option value="@a.Code">@a.Code · @a.Name</option> }
                                </select>
                            </td>
                            <td><input class="form-control form-control-sm" @bind="l.Description" /></td>
                            <td><input type="number" step="any" min="0" class="form-control form-control-sm text-end" @bind="l.Debit" @onfocus="() => l.Credit = 0" /></td>
                            <td><input type="number" step="any" min="0" class="form-control form-control-sm text-end" @bind="l.Credit" @onfocus="() => l.Debit = 0" /></td>
                            <td><button class="btn-danger btn-sm" @onclick="() => _edit.Lines.Remove(l)">✕</button></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="2" class="text-end">Totales</td>
                        <td class="text-end">@_edit.TotalDebit.ToString("N2")</td>
                        <td class="text-end">@_edit.TotalCredit.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
            <div class="d-flex justify-content-between align-items-center">
                <button class="btn-secondary btn-sm" @onclick="() => _edit.Lines.Add(new JournalLine())">+ Línea</button>
                @if (_edit.Difference == 0 && _edit.TotalDebit > 0)
                {
                    <span class="badge-soft ok">✓ Cuadrado</span>
                }
                else
                {
                    <span class="text-danger small">Diferencia: @_edit.Difference.ToString("N2")</span>
                }
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <button class="btn-secondary" @onclick="() => _edit = null">Cerrar</button>
            <span class="d-flex gap-2">
                <button class="btn-secondary" @onclick="SaveDraftAsync">Guardar borrador</button>
                <button class="btn-primary" @onclick="PostAsync">Registrar asiento</button>
            </span>
        </div>
    </div>
}

@if (_entries is null) { <p class="muted">Cargando…</p> }
else if (_entries.Count == 0 && _edit is null && !_wizard) { <div class="empty-state">Aún no hay asientos. Cree el primero con “@(_isAdmin ? "+ Nuevo asiento" : "")” o el asistente.</div> }
else if (_entries.Count > 0)
{
    @* ---- Resumen ---- *@
    <div class="jd-summary">
        <div class="jd-stat ok">
            <div class="jd-stat-val">@CountOf("posted")</div>
            <div class="jd-stat-lbl">Registrados</div>
        </div>
        <div class="jd-stat">
            <div class="jd-stat-val jd-amt">@PostedTotal.ToString("N2") <small class="muted" style="font-size:.7rem">CRC</small></div>
            <div class="jd-stat-lbl">Total registrado</div>
        </div>
        <div class="jd-stat muted-stat">
            <div class="jd-stat-val">@CountOf("draft")</div>
            <div class="jd-stat-lbl">Borradores</div>
        </div>
        <div class="jd-stat muted-stat">
            <div class="jd-stat-val">@CountOf("void")</div>
            <div class="jd-stat-lbl">Anulados</div>
        </div>
    </div>

    @* ---- Filtros ---- *@
    <div class="toolbar">
        <div class="search">
            <span aria-hidden="true">🔎</span>
            <input placeholder="Buscar descripción, referencia o N.º…" @bind="_q" @bind:event="oninput" />
        </div>
        <select @bind="_statusFilter">
            <option value="">Todos los estados</option>
            @foreach (var s in JournalStatuses.All) { <option value="@s.Id">@s.Label</option> }
        </select>
        <label class="muted small">Desde <input type="date" class="form-control form-control-sm d-inline-block" style="width:auto" @bind="_from" /></label>
        <label class="muted small">Hasta <input type="date" class="form-control form-control-sm d-inline-block" style="width:auto" @bind="_to" /></label>
        @if (AnyFilter)
        {
            <button class="tool" @onclick="ClearFilters">✕ Limpiar</button>
            <span class="muted small">@_filtered.Count de @_entries.Count</span>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th style="width:60px">N.º</th><th style="width:110px">Fecha</th><th>Descripción</th><th>Referencia</th><th class="text-end" style="width:150px">Monto</th><th style="width:110px">Estado</th><th style="width:140px"></th></tr></thead>
            <tbody>
                @if (_filtered.Count == 0)
                {
                    <tr><td colspan="7"><div class="jd-empty-filter">No hay asientos que coincidan con el filtro.</div></td></tr>
                }
                @foreach (var e in _filtered)
                {
                    var st = JournalStatuses.Get(e.Status);
                    var isOpen = _expanded == e.Id;
                    <tr>
                        <td class="small muted">@(e.Number > 0 ? e.Number.ToString() : "—")</td>
                        <td class="small text-nowrap">@e.Date.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>@e.Description</td>
                        <td class="small muted">@e.Reference</td>
                        <td class="text-end jd-amt">@e.TotalDebit.ToString("N2") <small class="muted">@e.Currency</small></td>
                        <td><Badge Text="@st.Label" Color="@st.Color" /></td>
                        <td>
                            <div class="jd-actions">
                                <button class="btn-secondary btn-sm" title="@(e.Status == "draft" && _isAdmin ? "Editar borrador" : isOpen ? "Ocultar detalle" : "Ver detalle")" @onclick="() => View(e)">
                                    @(e.Status == "draft" && _isAdmin ? "Editar" : isOpen ? "Ocultar" : "Ver")
                                </button>
                                @if (_isAdmin)
                                {
                                    @if (e.Status == "posted") { <button class="btn-secondary btn-sm" title="Anular (reversa auditable)" @onclick="() => VoidAsync(e)">Anular</button> }
                                    <button class="icon-btn jd-del" title="Eliminar definitivamente" @onclick="() => DeleteAsync(e)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (isOpen)
                    {
                        <tr class="jd-detail"><td></td><td colspan="6">
                            <table class="table table-sm mb-0">
                                <thead><tr><th>Cuenta</th><th>Detalle</th><th class="text-end">Débito</th><th class="text-end">Crédito</th></tr></thead>
                                <tbody>
                                    @foreach (var l in e.Lines.Where(x => x.HasMovement))
                                    {
                                        <tr>
                                            <td class="small"><span class="jd-dot" style="background:@AccColor(l.AccountCode)"></span>@l.AccountCode · @l.AccountName</td>
                                            <td class="small muted">@l.Description</td>
                                            <td class="text-end jd-amt">@(l.Debit != 0 ? l.Debit.ToString("N2") : "")</td>
                                            <td class="text-end jd-amt">@(l.Credit != 0 ? l.Credit.ToString("N2") : "")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-semibold">
                                        <td colspan="2" class="text-end small">Totales</td>
                                        <td class="text-end jd-amt">@e.TotalDebit.ToString("N2")</td>
                                        <td class="text-end jd-amt">@e.TotalCredit.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<JournalEntry>? _entries;
    private List<Account> _postable = new();
    private JournalEntry? _edit;
    private bool _wizard;
    private string? _expanded;
    private string? _msg, _err;
    private bool _isAdmin;

    // Filtros
    private string _q = "";
    private string _statusFilter = "";
    private DateTime? _from, _to;

    private List<JournalEntry> _filtered => (_entries ?? new())
        .Where(e => _statusFilter == "" || e.Status == _statusFilter)
        .Where(e => _from is null || e.Date.Date >= _from.Value.Date)
        .Where(e => _to is null || e.Date.Date <= _to.Value.Date)
        .Where(e => string.IsNullOrWhiteSpace(_q)
            || (e.Description ?? "").Contains(_q, StringComparison.OrdinalIgnoreCase)
            || (e.Reference ?? "").Contains(_q, StringComparison.OrdinalIgnoreCase)
            || e.Number.ToString().Contains(_q))
        .OrderByDescending(e => e.Date).ThenByDescending(e => e.Number)
        .ToList();

    private bool AnyFilter => !string.IsNullOrWhiteSpace(_q) || _statusFilter != "" || _from is not null || _to is not null;
    private void ClearFilters() { _q = ""; _statusFilter = ""; _from = _to = null; }

    private int CountOf(string status) => _entries?.Count(e => e.Status == status) ?? 0;
    private decimal PostedTotal => _entries?.Where(e => e.Status == "posted").Sum(e => e.TotalDebit) ?? 0;
    private string AccColor(string code)
    {
        var a = _postable.FirstOrDefault(x => x.Code == code);
        return a is null ? "var(--border)" : AccountTypes.Color(a.Type);
    }

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Me.IsAdminAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _entries = await Accounting.GetEntriesAsync();
        _postable = await Accounting.GetPostableAsync();
    }

    private void NewEntry()
    {
        _err = _msg = null;
        _wizard = false;
        _edit = new JournalEntry { Lines = { new JournalLine(), new JournalLine() } };
    }

    private void StartWizard()
    {
        _err = _msg = null;
        _edit = null;
        _wizard = true;
    }

    private async Task WizardDone(string message)
    {
        _wizard = false;
        _msg = message; _err = null;
        await LoadAsync();
    }

    private void View(JournalEntry e)
    {
        _err = _msg = null;
        if (e.Status == "draft" && _isAdmin) _edit = e;
        else _expanded = _expanded == e.Id ? null : e.Id;
    }

    private async Task SaveDraftAsync()
    {
        var (ok, error) = await Accounting.SaveDraftAsync(_edit!);
        if (!ok) { _err = error; return; }
        _msg = "Borrador guardado."; _err = null;
        await LoadAsync();
    }

    private async Task PostAsync()
    {
        var val = AccountingService.Validate(_edit!);
        if (val is not null) { _err = val; return; }
        var (ok, _) = await Accounting.SaveDraftAsync(_edit!);
        if (!ok) { _err = "No se pudo guardar antes de registrar."; return; }
        var (pok, perror) = await Accounting.PostAsync(_edit!.Id!);
        if (!pok) { _err = perror; await LoadAsync(); return; }
        _msg = "Asiento registrado."; _err = null; _edit = null;
        await LoadAsync();
    }

    private async Task VoidAsync(JournalEntry e)
    {
        if (!await Dialogs.ConfirmAsync($"¿Anular el asiento N.º {e.Number}? Dejará de contar en los saldos.")) return;
        var (ok, error) = await Accounting.VoidAsync(e.Id!);
        _err = ok ? null : error; _msg = ok ? "Asiento anulado." : null;
        await LoadAsync();
    }

    private async Task DeleteAsync(JournalEntry e)
    {
        if (!_isAdmin) return;
        var warn = e.Status switch
        {
            "posted" => $"¿Eliminar DEFINITIVAMENTE el asiento N.º {e.Number}? Dejará un hueco en el consecutivo y se perderá el rastro contable. Para una corrección auditable use «Anular». ¿Continuar?",
            "void" => $"¿Eliminar definitivamente este asiento anulado (N.º {e.Number})?",
            _ => "¿Eliminar este borrador?",
        };
        if (!await Dialogs.ConfirmAsync(warn)) return;
        await Accounting.DeleteEntryAsync(e.Id!);
        if (_edit?.Id == e.Id) _edit = null;
        _msg = "Asiento eliminado."; _err = null;
        await LoadAsync();
    }
}
