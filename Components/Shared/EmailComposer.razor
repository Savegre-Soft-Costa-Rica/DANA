@inject EmailService Email
@inject CurrentUser Me

@if (Open)
{
    <div class="sheet-backdrop" @onclick="CloseAsync"></div>
    <div class="sheet" style="width:min(680px,94vw)">
        <div class="sheet-head"><strong>✉ Enviar correo</strong><button class="icon-btn" @onclick="CloseAsync">✕</button></div>
        <div class="sheet-body">
            @if (!Email.IsConfigured)
            {
                <div class="alert alert-warning small">SMTP no está configurado (<code>Email:Smtp</code>). El correo se registrará en la línea de tiempo y podrá abrirlo en su cliente de correo.</div>
            }
            <div class="row g-2">
                <div class="col-md-7">
                    <label class="form-label">Para</label>
                    <input class="form-control" @bind="_to" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Plantilla</label>
                    <select class="form-select" @onchange="ApplyTemplate">
                        <option value="">— Sin plantilla —</option>
                        @foreach (var t in _templates) { <option value="@t.Id">@t.Name</option> }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Asunto</label>
                    <input class="form-control" @bind="_subject" />
                </div>
                <div class="col-12">
                    <label class="form-label">Mensaje</label>
                    <textarea class="form-control" rows="9" @bind="_body"></textarea>
                    <div class="muted small mt-1">Marcadores disponibles en plantillas: {{nombre}}, {{apellido}}, {{compañía}}, {{correo}}, {{titulo}}, {{usuario}}.</div>
                </div>
            </div>
            @if (_result is not null) { <div class="alert @(_sent ? "alert-success" : "alert-warning") small mt-2">@_result</div> }
        </div>
        <div class="sheet-foot">
            <a class="btn-secondary" href="@MailtoLink" target="_blank">Abrir en mi correo</a>
            <button class="btn-primary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_to) || string.IsNullOrWhiteSpace(_subject))">@(_busy ? "Enviando…" : Email.IsConfigured ? "Enviar" : "Registrar")</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? To { get; set; }
    [Parameter] public EmailContext Context { get; set; } = new(null, null, null, null, null, "");
    [Parameter] public string EntityType { get; set; } = "";
    [Parameter] public string EntityId { get; set; } = "";
    [Parameter] public string EntityTitle { get; set; } = "";
    [Parameter] public EventCallback OnSent { get; set; }

    private List<EmailTemplate> _templates = new();
    private string _to = "", _subject = "", _body = "";
    private bool _busy, _sent, _wasOpen;
    private string? _result;

    private string MailtoLink => $"mailto:{Uri.EscapeDataString(_to)}?subject={Uri.EscapeDataString(_subject)}&body={Uri.EscapeDataString(_body)}";

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !_wasOpen)
        {
            _templates = await Email.GetTemplatesAsync();
            _to = To ?? ""; _subject = ""; _body = ""; _result = null;
            _wasOpen = true;
        }
        if (!Open) _wasOpen = false;
    }

    private async Task ApplyTemplate(ChangeEventArgs e)
    {
        var t = _templates.FirstOrDefault(x => x.Id == e.Value?.ToString());
        if (t is null) return;
        var ctx = Context with { User = await Me.NameAsync() };
        _subject = EmailService.Render(t.Subject, ctx);
        _body = EmailService.Render(t.Body, ctx);
    }

    private async Task SendAsync()
    {
        _busy = true; _result = null;
        try
        {
            var (sent, error) = await Email.SendAsync(_to.Trim(), _subject.Trim(), _body, EntityType, EntityId, EntityTitle, await Me.NameAsync());
            _sent = sent;
            _result = sent ? "Correo enviado y registrado en la línea de tiempo." : error is not null ? $"No se pudo enviar ({error}). Se registró en la línea de tiempo." : "Correo registrado en la línea de tiempo.";
            await OnSent.InvokeAsync();
        }
        finally { _busy = false; }
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);
}
