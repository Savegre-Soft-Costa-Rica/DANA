<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Dana.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>try { var t = localStorage.getItem("dana.theme"); if (t === "dark") document.documentElement.dataset.theme = "dark"; } catch (e) { }</script>
    <script>
        // Sonido corto para notificaciones / mensajes nuevos (silenciable con dana.sound = "off")
        window.danaPing = function () {
            try {
                if (localStorage.getItem("dana.sound") === "off") return;
                var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
                var c = window.__danaAudio || (window.__danaAudio = new AC());
                if (c.state === "suspended") c.resume();
                var now = c.currentTime;
                [880, 1320].forEach(function (f, i) {
                    var o = c.createOscillator(), g = c.createGain();
                    o.type = "sine"; o.frequency.value = f;
                    var t0 = now + i * 0.12;
                    g.gain.setValueAtTime(0.0001, t0);
                    g.gain.exponentialRampToValueAtTime(0.08, t0 + 0.02);
                    g.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.14);
                    o.connect(g); g.connect(c.destination);
                    o.start(t0); o.stop(t0 + 0.15);
                });
            } catch (e) { }
        };
    </script>
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script type="module" src="sprites.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Las páginas de cuenta (login, registro…) se renderizan de forma estática en el servidor
    // porque necesitan HttpContext para firmar/cerrar la cookie de sesión.
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/cuenta") || HttpContext.Request.Path.StartsWithSegments("/formulario") || HttpContext.Request.Path.StartsWithSegments("/firmar") || HttpContext.Request.Path.StartsWithSegments("/catalogo") || HttpContext.Request.Path.StartsWithSegments("/doc") || HttpContext.Request.Path.StartsWithSegments("/pagar") || HttpContext.Request.Path.Value!.EndsWith("/imprimir") ? null : InteractiveServer;
}
