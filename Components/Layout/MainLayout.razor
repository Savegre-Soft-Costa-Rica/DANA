@inherits LayoutComponentBase
@implements IDisposable
@inject DrawerService Drawer
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PresenceService Presence
@inject CurrentUser Me
@inject ILogger<MainLayout> Logger
@inject IHostEnvironment Env

<CascadingValue Value="_readOnly" Name="ReadOnly">
<div class="app @(_collapsed ? "sidebar-collapsed" : "") @(_navOverlay ? "nav-overlay" : "")">
    <aside class="sidebar @(_navOpen ? "open" : "") @(_collapsed ? "collapsed" : "")">
        <NavMenu Collapsed="_collapsed" OnToggle="ToggleSidebarAsync" OnOverlayChange="v => _navOverlay = v" />
    </aside>
    @if (_navOpen)
    {
        <div class="nav-backdrop" @onclick="() => _navOpen = false"></div>
    }

    <div class="main">
        @if (_demo)
        {
            <div class="demo-banner">🧪 <strong>Modo demo</strong> — estás explorando con datos de prueba; algunos cambios se comparten con otros invitados.
                <form method="post" action="cuenta/logout" class="d-inline"><AntiforgeryToken /><button type="submit" class="demo-exit">Salir</button></form>
            </div>
        }
        @if (_readOnly)
        {
            <div class="demo-banner ro-banner">👁 <strong>Solo lectura</strong> — tu cuenta puede ver la información pero no modificarla.</div>
        }
        <TopBar OnToggleNav="() => _navOpen = !_navOpen" />
        <div class="content">
            <ErrorBoundary @ref="_boundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-box">
                        <div class="error-ico">⚠</div>
                        <h4>Algo salió mal en esta pantalla</h4>
                        <p class="muted">El resto de la aplicación sigue funcionando. Puede reintentar o volver al inicio.</p>
                        @if (Env.IsDevelopment()) { <pre class="code small">@ex.ToString()</pre> }
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn-primary" @onclick="() => _boundary?.Recover()">Reintentar</button>
                            <a class="btn-secondary" href="/">Ir al inicio</a>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </div>
</div>

@if (Drawer.IsOpen)
{
    <div class="drawer-backdrop" @onclick="Drawer.CloseAsync"></div>
    <div class="drawer">
        <div class="drawer-head">
            <span class="drawer-title">@Drawer.Title</span>
            <button class="icon-btn" title="Cerrar" @onclick="Drawer.CloseAsync">✕</button>
        </div>
        <div class="drawer-body">
            <ErrorBoundary>
                <ChildContent><DynamicComponent Type="Drawer.ComponentType!" Parameters="Drawer.Parameters" /></ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-box"><div class="error-ico">⚠</div><h4>No se pudo mostrar este elemento</h4>@if (Env.IsDevelopment()) { <pre class="code small">@ex.Message</pre> }<button class="btn-secondary" @onclick="Drawer.CloseAsync">Cerrar</button></div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </div>
}

<DialogHost />
<AgentBubble />

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
</CascadingValue>

@code {
    private bool _navOpen;
    private bool _collapsed;
    private bool _navOverlay;
    private ErrorBoundary? _boundary;
    private string? _me;
    private bool _demo;
    private bool _readOnly;
    private PeriodicTimer? _heartbeat;

    protected override void OnInitialized()
    {
        Drawer.StateChanged += OnDrawerChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    // Al navegar (p. ej. tocar un ítem del menú en mobile), cerrar el panel desplegado
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_navOpen) return;
        _navOpen = false;
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet() => _boundary?.Recover(); // al navegar a otra página, limpiar el error anterior

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "dana.sidebar");
            if (saved == "collapsed") { _collapsed = true; StateHasChanged(); }
        }
        catch { }

        // Presencia en línea: latir mientras el circuito esté vivo
        try
        {
            _me = await Me.NameAsync();
            _demo = await Me.IsDemoAsync();
            _readOnly = !await Me.CanWriteAsync();
            if (_demo || _readOnly) StateHasChanged();
            Presence.Heartbeat(_me);
            _ = HeartbeatLoopAsync();
        }
        catch { }
    }

    private async Task HeartbeatLoopAsync()
    {
        _heartbeat = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try { while (await _heartbeat.WaitForNextTickAsync()) Presence.Heartbeat(_me); }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task ToggleSidebarAsync()
    {
        _collapsed = !_collapsed;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "dana.sidebar", _collapsed ? "collapsed" : "open"); } catch { }
    }
    private void OnDrawerChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        _heartbeat?.Dispose();
        Presence.Offline(_me);
        Drawer.StateChanged -= OnDrawerChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
