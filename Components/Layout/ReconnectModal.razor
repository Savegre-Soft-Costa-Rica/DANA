<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <div class="reconnect-title">Dana</div>
        <p class="components-reconnect-first-attempt-visible">
            Reconectando con el servidor…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Sin conexión. Reintentando en <span id="components-seconds-to-next-attempt"></span> s…
            <br /><small>La página se recargará sola cuando el servidor responda.</small>
        </p>
        <p class="components-reconnect-failed-visible">
            No fue posible reconectar.<br /><small>Esperando a que el servidor vuelva a estar disponible…</small>
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible reconnect-btn">
            Reintentar ahora
        </button>
        <p class="components-pause-visible">
            El servidor pausó la sesión por inactividad.
        </p>
        <p class="components-resume-failed-visible">
            No se pudo reanudar la sesión.<br /><small>Recargue la página para continuar.</small>
        </p>
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible reconnect-btn">
            Reanudar
        </button>
        <button id="components-reload-button" class="reconnect-link">Recargar la página</button>
    </div>
</dialog>
