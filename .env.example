# ============ Dana CRM · variables de entorno ============
# Copie este archivo a .env (no se versiona). Lo usa docker-compose.prod.yml.
# En Coolify, defina estas mismas variables en Environment Variables.

# --- Base de datos (se arman dentro de la cadena de conexión) ---
MONGO_USER=dana
MONGO_PASSWORD=cambie-esta-contraseña
MONGO_DB=dana
TZ=America/Costa_Rica

# --- Google OAuth2: nombres FINALES que lee la app (sin intermediarios) ---
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
# Opcional: limitar a un dominio de correo (si no, cualquier cuenta de Google).
# Authentication__Google__AllowedDomains__0=savegresoft.com

# --- Registro de cuentas (por defecto abierto) ---
# Authentication__AllowRegistration=false
