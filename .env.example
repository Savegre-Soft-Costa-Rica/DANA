# ============ Dana CRM · variables de entorno ============
# Copie este archivo a .env (no se versiona). docker-compose.prod.yml las usa; también sirven para `dotnet run`
# (ASP.NET Core lee "__" como separador de secciones: Mongo__ConnectionString = Mongo:ConnectionString).

# --- Producción (docker-compose.prod.yml) ---
MONGO_USER=dana
MONGO_PASSWORD=cambie-esta-contraseña
MONGO_DB=dana
DANA_PORT=9000
TZ=America/Costa_Rica
# Registro abierto (true) o solo cuentas creadas por el admin (false)
ALLOW_REGISTRATION=true

# --- Google OAuth2 (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# --- Correo saliente SMTP (opcional; sin configurar, los correos solo se registran) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Dana CRM

# --- Desarrollo local con `dotnet run` (equivalentes directos) ---
# Mongo__ConnectionString=mongodb://localhost:27017
# Mongo__Database=dana
# Authentication__Google__ClientId=...
# Email__Smtp__Host=smtp.gmail.com
